@page "/cmmn-modeler"
@using System.Text
@using Microsoft.AspNetCore.Components.Forms
@inject MudBlazor.ISnackbar Snackbar
@inject ICaseManagementService CaseManagementService
@inject IJSRuntime JSRuntime
@inject IWebHostEnvironment HostEnvironment

<PageTitle>CMMN Modeler</PageTitle>

<MudStack Spacing="3" Class="studio-editor-page">
    <StudioPageHeader Title="CMMN Modeler"
                      Eyebrow="Model"
                      Description="Design, register and execute adaptive case models." />

    <StudioToolbar AriaLabel="CMMN model actions" Class="studio-editor-toolbar">
            <MudTextField Label="Case ID" @bind-Value="_caseId" Required="true" Immediate="true" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="RegisterCmmnXml" StartIcon="@Icons.Material.Filled.CloudUpload">Register case model</MudButton>
            <label class="mud-button-root mud-button mud-button-outlined mud-button-outlined-primary mud-button-outlined-size-medium mud-ripple" for="cmmn-import-file">
                <MudIcon Icon="@Icons.Material.Filled.UploadFile" Size="Size.Small" Class="me-2" />
                Import CMMN
            </label>
            <InputFile id="cmmn-import-file" data-testid="cmmn-import-file" OnChange="ImportCmmnAsync" accept=".cmmn,.xml,application/xml,text/xml" style="display:none" />
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="ExportCmmnXml" StartIcon="@Icons.Material.Filled.Download">Export CMMN</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="ExecuteCase" StartIcon="@Icons.Material.Filled.PlayArrow">Execute case</MudButton>
            <MudButton Variant="Variant.Outlined" OnClick="LoadHistory">Load history</MudButton>
            <MudButton Variant="Variant.Outlined" OnClick="@(() => LoadCmmnXml())">Load template</MudButton>
            <MudTextField Label="New task name" @bind-Value="_newTaskName" Immediate="true" />
            <MudButton Variant="Variant.Outlined" OnClick="AddHumanTaskAsync" Disabled="@string.IsNullOrWhiteSpace(_newTaskName)">Add human task</MudButton>
    </StudioToolbar>

    <MudPaper Class="studio-modeler-card" Elevation="0">
        <div class="studio-modeler-card__header">
            <div>
                <MudText Typo="Typo.h6">Case model</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">Edit plan items, events and discretionary work.</MudText>
            </div>
            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Icon="@Icons.Material.Outlined.Edit">Editing</MudChip>
        </div>
        <CmmnModelerSurface @ref="_modeler" Xml="@_cmmnXml" />
    </MudPaper>

    <div class="studio-bpmn-tools studio-editor-tools">
        <div class="studio-bpmn-tools__tabs" role="tablist" aria-label="CMMN tools">
            <button type="button" role="tab" aria-selected="@AriaSelected(0)" class="studio-bpmn-tools__tab @ToolTabClass(0)" @onclick="@(() => _activeToolTab = 0)"><MudIcon Icon="@Icons.Material.Outlined.PlayCircle" Size="Size.Small" />Runtime</button>
            <button type="button" role="tab" aria-selected="@AriaSelected(1)" class="studio-bpmn-tools__tab @ToolTabClass(1)" @onclick="@(() => _activeToolTab = 1)"><MudIcon Icon="@Icons.Material.Outlined.Visibility" Size="Size.Small" />Viewer</button>
        </div>
        <div class="studio-bpmn-tools__panels">
            <section role="tabpanel" hidden="@(_activeToolTab != 0)">
                <MudStack Spacing="3" Class="studio-bpmn-tool-panel">
                    <div>
                        <MudText Typo="Typo.h6">Case actions</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Drive user events and case-file updates for the registered case.</MudText>
                    </div>
                    <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2">
                        <MudTextField Label="User event id" @bind-Value="_eventId" Immediate="true" />
                        <MudButton Variant="Variant.Outlined" OnClick="TriggerUserEvent">Trigger user event</MudButton>
                        <MudTextField Label="Case-file item id" @bind-Value="_caseFileItemId" Immediate="true" />
                        <MudTextField Label="Value" @bind-Value="_caseFileValue" Immediate="true" />
                        <MudButton Variant="Variant.Outlined" OnClick="UpdateCaseFile">Update case file</MudButton>
                        <MudButton Variant="Variant.Outlined" OnClick="GenerateAdHoc">Generate ad-hoc subprocess</MudButton>
                    </MudStack>
                    @if (_trace.Count > 0)
                    {
                        <MudDivider />
                        <MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Spacing="2">
                            <MudText Typo="Typo.h6">Case runtime status</MudText>
                            <MudChip T="string" Color="Color.Success" Variant="Variant.Outlined">Completed: @_completedPlanItems.Count</MudChip>
                            <MudChip T="string" Color="Color.Info" Variant="Variant.Outlined">User events: @_userEvents.Count</MudChip>
                            <MudChip T="string" Color="Color.Secondary" Variant="Variant.Outlined">Milestones: @_milestones.Count</MudChip>
                        </MudStack>
                        @if (_completedPlanItems.Count > 0 || _userEvents.Count > 0 || _milestones.Count > 0)
                        {
                            <MudGrid>
                                <MudItem xs="12" md="4"><MudText Typo="Typo.subtitle2">Completed plan items</MudText><MudText>@(_completedPlanItems.Count == 0 ? "None" : string.Join(", ", _completedPlanItems))</MudText></MudItem>
                                <MudItem xs="12" md="4"><MudText Typo="Typo.subtitle2">User events</MudText><MudText>@(_userEvents.Count == 0 ? "None" : string.Join(", ", _userEvents))</MudText></MudItem>
                                <MudItem xs="12" md="4"><MudText Typo="Typo.subtitle2">Milestones</MudText><MudText>@(_milestones.Count == 0 ? "None" : string.Join(", ", _milestones))</MudText></MudItem>
                            </MudGrid>
                        }
                        <MudList T="string">
                            @foreach (var line in _trace)
                            {
                                <MudListItem T="string">@line</MudListItem>
                            }
                        </MudList>
                    }
                    @if (_history.Count > 0)
                    {
                        <MudDivider />
                        <MudText Typo="Typo.h6">Case history timeline</MudText>
                        @foreach (var snapshot in _history)
                        {
                            <MudPaper Class="pa-2" Outlined="true">
                                <MudText Typo="Typo.subtitle2">@snapshot.Timestamp.ToUniversalTime().ToString("O")</MudText>
                                <MudText>Completed plan items: @(snapshot.CompletedPlanItems.Count == 0 ? "None" : string.Join(", ", snapshot.CompletedPlanItems))</MudText>
                                <MudText>Case-file values: @(snapshot.CaseFile.Count == 0 ? "None" : string.Join(", ", snapshot.CaseFile.Select(value => $"{value.Key}={value.Value}")))</MudText>
                            </MudPaper>
                        }
                    }
                </MudStack>
            </section>
            <section role="tabpanel" hidden="@(_activeToolTab != 1)">
                <div class="studio-bpmn-tool-panel studio-bpmn-tool-panel--viewer">
                    @if (_activeToolTab == 1)
                    {
                        <CmmnViewerSurface Xml="@_cmmnXml" />
                    }
                </div>
            </section>
        </div>
    </div>
</MudStack>

@code {
    private string _cmmnXml = FallbackCmmn;
    private CmmnModelerSurface? _modeler;
    private string _caseId = "studio-case";
    private List<string> _trace = new();
    private List<HistoricalCaseSnapshot> _history = new();
    private IReadOnlyList<string> _completedPlanItems = [];
    private IReadOnlyList<string> _userEvents = [];
    private IReadOnlyList<string> _milestones = [];
    private string _eventId = string.Empty;
    private string _caseFileItemId = string.Empty;
    private string _caseFileValue = string.Empty;
    private string _newTaskName = string.Empty;
    private int _activeToolTab;

    private string? ToolTabClass(int index) => _activeToolTab == index ? "studio-bpmn-tools__tab--active" : null;

    private string AriaSelected(int index) => _activeToolTab == index ? "true" : "false";

    private async Task AddHumanTaskAsync()
    {
        if (_modeler is null || string.IsNullOrWhiteSpace(_newTaskName))
            return;

        await _modeler.AddHumanTaskAsync(_newTaskName.Trim());
        _cmmnXml = await _modeler.GetXmlAsync();
        Snackbar.Add("Human task added to the case model.", Severity.Success);
    }

    private const string FallbackCmmn = """
<?xml version="1.0" encoding="UTF-8"?>
<cmmn:definitions xmlns:cmmn="http://www.omg.org/spec/CMMN/20151109/MODEL" id="Defs_Fallback" targetNamespace="http://vertexbpmn.io/cmmn">
  <cmmn:case id="Case_Fallback" name="Fallback Case">
    <cmmn:casePlanModel id="CasePlanModel_Fallback" name="Fallback plan" />
  </cmmn:case>
</cmmn:definitions>
""";

    protected override async Task OnInitializedAsync()
    {
        await LoadCmmnXml(showNotification: false);
    }

    private async Task RegisterCmmnXml()
    {
        try
        {
            _cmmnXml = await CaptureCmmnXml();
            await CaseManagementService.RegisterModelAsync(_caseId, _cmmnXml);
            Snackbar.Add($"CMMN model registered for case '{_caseId}'.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"CMMN register failed: {ex.Message}", Severity.Error);
        }
    }

    private async Task ExportCmmnXml()
    {
        _cmmnXml = await CaptureCmmnXml();
        await DownloadTextAsync($"{_caseId}.cmmn", _cmmnXml, "application/xml");
        Snackbar.Add("CMMN XML exported.", Severity.Success);
    }

    private async Task ImportCmmnAsync(InputFileChangeEventArgs args)
    {
        var file = args.File;
        if (file.Size > 10 * 1024 * 1024)
        {
            Snackbar.Add("CMMN file exceeds the 10 MB limit.", Severity.Error);
            return;
        }

        await using var stream = file.OpenReadStream(10 * 1024 * 1024);
        using var reader = new StreamReader(stream);
        _cmmnXml = await reader.ReadToEndAsync();
        if (_modeler is not null)
            await _modeler.LoadXmlAsync(_cmmnXml);
        Snackbar.Add($"Imported {file.Name}.", Severity.Success);
    }

    private async Task ExecuteCase()
    {
        try
        {
            _trace = (await CaseManagementService.ExecuteCaseAsync(_caseId)).ToList();
            UpdateRuntimeStatus();
            Snackbar.Add($"Case '{_caseId}' executed.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Case execution failed: {ex.Message}", Severity.Error);
        }
    }

    private async Task LoadHistory()
    {
        try
        {
            _history = (await CaseManagementService.GetHistoricalContextAsync(_caseId)).ToList();
            Snackbar.Add($"Loaded {_history.Count} historical snapshot(s).", Severity.Info);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"History load failed: {ex.Message}", Severity.Error);
        }
    }

    private void UpdateRuntimeStatus()
    {
        const string completedPrefix = "PLAN_ITEM_COMPLETED:";
        _completedPlanItems = _trace.Where(line => line.StartsWith(completedPrefix, StringComparison.Ordinal))
            .Select(line => line[completedPrefix.Length..].Split(':', 2)[0].Trim()).Distinct().ToArray();
        _userEvents = _trace.Where(line => line.Contains("USER_EVENT", StringComparison.OrdinalIgnoreCase) || line.Contains("eventListener", StringComparison.OrdinalIgnoreCase))
            .Distinct().ToArray();
        _milestones = _trace.Where(line => line.Contains(":milestone", StringComparison.OrdinalIgnoreCase))
            .Distinct().ToArray();
    }

    private async Task TriggerUserEvent()
    {
        try
        {
            await CaseManagementService.TriggerUserEventAsync(_caseId, _eventId, new Dictionary<string, string>());
            Snackbar.Add($"User event '{_eventId}' triggered.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"User event failed: {ex.Message}", Severity.Error);
        }
    }

    private async Task UpdateCaseFile()
    {
        try
        {
            await CaseManagementService.UpdateCaseFileItemAsync(_caseId, _caseFileItemId, _caseFileValue);
            Snackbar.Add($"Case-file item '{_caseFileItemId}' updated.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Case-file update failed: {ex.Message}", Severity.Error);
        }
    }

    private async Task GenerateAdHoc()
    {
        try
        {
            await CaseManagementService.GenerateAdHocSubprocessAsync(_caseId);
            Snackbar.Add("Ad-hoc subprocess generated.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Ad-hoc subprocess failed: {ex.Message}", Severity.Error);
        }
    }

    private async Task LoadCmmnXml(bool showNotification = true)
    {
        try
        {
            var templatePath = Path.Combine(HostEnvironment.WebRootPath, "data", "DefaultCmmn.xml");
            _cmmnXml = await File.ReadAllTextAsync(templatePath);
            if (showNotification)
                Snackbar.Add("CMMN template loaded.", Severity.Info);
        }
        catch (Exception ex)
        {
            _cmmnXml = FallbackCmmn;
            if (showNotification)
                Snackbar.Add($"CMMN template not found. Using fallback. ({ex.Message})", Severity.Warning);
        }
    }

    private async Task<string> CaptureCmmnXml()
    {
        if (_modeler is not null)
            _cmmnXml = await _modeler.GetXmlAsync();
        return _cmmnXml;
    }

    private async Task DownloadTextAsync(string fileName, string content, string contentType)
    {
        var dataUri = $"data:{contentType};base64,{Convert.ToBase64String(Encoding.UTF8.GetBytes(content))}";
        await JSRuntime.InvokeVoidAsync("downloadFile", fileName, dataUri);
    }
}
