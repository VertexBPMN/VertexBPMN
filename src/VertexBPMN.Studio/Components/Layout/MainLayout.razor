@inherits LayoutComponentBase
@implements IDisposable
@inject VertexBPMN.Studio.Services.ActiveEngineService ActiveEngineService
@inject VertexBPMN.Studio.Services.IIdentityService IdentityService
@inject VertexBPMN.Studio.Services.StudioTenantContext TenantContext
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ILogger<MainLayout> Logger

<MudThemeProvider Theme="_theme" />
<MudDialogProvider />
<MudSnackbarProvider />
<MudPopoverProvider />

<MudLayout Class="studio-layout" data-interactive-ready="@_interactiveReady.ToString().ToLowerInvariant()">
    <MudAppBar Elevation="0" Class="studio-appbar" Dense="true">
        <MudIconButton Icon="@Icons.Material.Filled.Menu"
                       Color="Color.Inherit"
                       Edge="Edge.Start"
                       Class="studio-menu-button"
                       aria-label="Toggle navigation"
                       OnClick="DrawerToggle" />

        <a href="/" class="studio-brand" aria-label="VertexBPMN Studio home">
            <span class="studio-brand__mark" aria-hidden="true">V</span>
            <span class="studio-brand__copy">
                <span class="studio-brand__name">VertexBPMN</span>
                <span class="studio-brand__product">Studio</span>
            </span>
        </a>
        <MudSpacer />

        <div class="studio-context" aria-label="Runtime context">
            <MudSelect T="string"
                       Label="Tenant"
                       Value="TenantContext.CurrentTenantId"
                       ValueChanged="SelectTenant"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Class="studio-context__select studio-context__tenant"
                       data-testid="tenant-context"
                       Disabled="!_tenantsLoaded || !_canSelectTenant">
                <MudSelectItem Value="@((string?)null)">Default</MudSelectItem>
                @foreach (var tenant in _tenants)
                {
                    <MudSelectItem Value="@tenant.Id">@tenant.Name</MudSelectItem>
                }
            </MudSelect>

            <MudSelect T="string"
                       Label="Engine"
                       @bind-Value="ActiveEngineService.ActiveEngineId"
                       Disabled="true"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Class="studio-context__select studio-context__engine">
                <MudSelectItem Value="@ActiveEngineService.ActiveEngineId">Configured API</MudSelectItem>
            </MudSelect>

            <MudChip T="string"
                     Color="@(ActiveEngineService.IsConnected ? Color.Success : Color.Error)"
                     Variant="Variant.Outlined"
                     Size="Size.Small"
                     Icon="@(ActiveEngineService.IsConnected ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Error)"
                     Class="studio-connection-status">
                @ActiveEngineService.ConnectionStatus
            </MudChip>

            <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                           Color="Color.Inherit"
                           Class="studio-context__refresh"
                           aria-label="Refresh engines"
                           Disabled="ActiveEngineService.IsChecking"
                           OnClick="RefreshEngines" />

            <form method="post" action="/authentication/logout" class="studio-logout-form">
                <AntiforgeryToken />
                <button type="submit" class="studio-logout-button" aria-label="Sign out">
                    <span aria-hidden="true">↪</span>
                    <span>Sign out</span>
                </button>
            </form>
        </div>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen"
               Elevation="0"
               Variant="DrawerVariant.Responsive"
               Breakpoint="Breakpoint.Md"
               Class="studio-drawer">
        <MudDrawerHeader Class="studio-drawer__header">
            <MudText Typo="Typo.overline">Workspace</MudText>
        </MudDrawerHeader>
        <NavMenu />
    </MudDrawer>

    <MudMainContent Class="studio-main">
        <main class="@ContentClass" id="main-content">
            @Body
        </main>
    </MudMainContent>
</MudLayout>

@code {
    private static readonly MudTheme _theme = VertexBPMN.Studio.Styling.StudioTheme.Default;

    private bool _drawerOpen = true;
    private bool _interactiveReady;
    private IReadOnlyList<VertexBPMN.Studio.Services.StudioTenant> _tenants = Array.Empty<VertexBPMN.Studio.Services.StudioTenant>();
    private bool _tenantsLoaded;
    private bool _canSelectTenant;

    protected override async Task OnInitializedAsync()
    {
        TenantContext.TenantsChanged += OnTenantsChanged;
        ActiveEngineService.OnChange += OnEngineStatusChanged;
        AuthenticationStateProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;
        var principal = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        _canSelectTenant = principal.IsInRole("Admin");
        if (!_canSelectTenant)
        {
            var tenantId = principal.FindFirst("tenant_id")?.Value;
            if (!string.IsNullOrWhiteSpace(tenantId))
            {
                TenantContext.SetTenant(tenantId);
                _tenants = [new VertexBPMN.Studio.Services.StudioTenant(tenantId, tenantId)];
            }
            _tenantsLoaded = true;
            return;
        }

        for (var attempt = 1; attempt <= 3; attempt++)
        {
            using var timeout = new CancellationTokenSource(TimeSpan.FromSeconds(15));
            try
            {
                _tenants = await IdentityService.ListTenantsAsync(timeout.Token);
                _tenantsLoaded = true;
                return;
            }
            catch (OperationCanceledException) when (timeout.IsCancellationRequested)
            {
                Logger.LogWarning("Loading tenants timed out on attempt {Attempt}; retrying", attempt);
            }
            catch (Exception exception)
            {
                Logger.LogWarning(exception, "Loading tenants failed on attempt {Attempt}; retrying", attempt);
            }

            if (attempt < 3)
                await Task.Delay(TimeSpan.FromSeconds(1));
        }

        Logger.LogError("Failed to load tenants in MainLayout after three attempts");
        _tenantsLoaded = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        _interactiveReady = true;
        StateHasChanged();
        await ActiveEngineService.CheckConnectionAsync();
    }

    private Task RefreshEngines() => ActiveEngineService.CheckConnectionAsync();

    private void DrawerToggle() => _drawerOpen = !_drawerOpen;

    private void SelectTenant(string? tenantId)
    {
        if (!_canSelectTenant)
            return;
        TenantContext.SetTenant(tenantId);
        StateHasChanged();
    }

    private async void OnTenantsChanged()
    {
        if (!_canSelectTenant) return;
        await InvokeAsync(async () =>
        {
            using var timeout = new CancellationTokenSource(TimeSpan.FromSeconds(15));
            try
            {
                _tenants = await IdentityService.ListTenantsAsync(timeout.Token);
                if (TenantContext.CurrentTenantId is { } selected && !_tenants.Any(tenant => tenant.Id == selected))
                    TenantContext.SetTenant(null);
                StateHasChanged();
            }
            catch (Exception exception)
            {
                Logger.LogWarning(exception, "Refreshing tenant selection failed");
            }
        });
    }

    private void OnEngineStatusChanged() => _ = InvokeAsync(StateHasChanged);

    private async void OnAuthenticationStateChanged(Task<AuthenticationState> stateTask)
    {
        await InvokeAsync(async () =>
        {
            var principal = (await stateTask).User;
            var wasAdmin = _canSelectTenant;
            _canSelectTenant = principal.IsInRole("Admin");
            if (!_canSelectTenant)
            {
                var tenantId = principal.Identity?.IsAuthenticated == true ? principal.FindFirst("tenant_id")?.Value : null;
                TenantContext.SetTenant(tenantId);
                _tenants = string.IsNullOrWhiteSpace(tenantId) ? [] : [new StudioTenant(tenantId, tenantId)];
            }
            else if (!wasAdmin)
                OnTenantsChanged();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        TenantContext.TenantsChanged -= OnTenantsChanged;
        ActiveEngineService.OnChange -= OnEngineStatusChanged;
        AuthenticationStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
    }

    private string ContentClass => IsWorkspaceRoute()
        ? "studio-content studio-content--workspace"
        : "studio-content";

    private bool IsWorkspaceRoute()
    {
        var path = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].TrimEnd('/');
        return path is "bpmn-modeler" or "dmn-modeler" or "cmmn-modeler" or "form-builder";
    }

}
