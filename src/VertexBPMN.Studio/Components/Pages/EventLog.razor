@page "/event-log"
@inject VertexBPMN.Studio.Services.IEngineEventService EngineEventService
@inject VertexBPMN.Studio.Services.IHistoryService HistoryService
@inject VertexBPMN.Studio.Services.StudioTenantContext TenantContext
@implements IDisposable

<PageTitle>Event Log</PageTitle>

<StudioPageHeader Title="Event Log" Eyebrow="Analyze" Description="Inspect persisted engine events for the active tenant.">
    <Actions><MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadAsync" Disabled="_isLoading">Refresh</MudButton></Actions>
</StudioPageHeader>

@if (_error is not null)
{
    <StudioStatePanel Title="Event log could not be loaded" Description="@_error" Icon="@Icons.Material.Outlined.ErrorOutline" />
}
else
{
<MudPaper Class="studio-data-card" Elevation="0">
<MudTable Items="_events" Hover="true" Dense="true" Loading="_isLoading" Breakpoint="Breakpoint.Md" Class="studio-data-table" data-testid="persistent-event-log-table">
    <HeaderContent>
        <MudTh>Timestamp</MudTh>
        <MudTh>Event</MudTh>
        <MudTh>Process instance</MudTh>
        <MudTh>Element</MudTh>
        <MudTh>Details</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Timestamp">@context.Timestamp.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</MudTd>
        <MudTd DataLabel="Event">@FormatEventType(context.EventType)</MudTd>
        <MudTd DataLabel="Process instance"><span class="studio-technical-id">@context.ProcessInstanceId</span></MudTd>
        <MudTd DataLabel="Element">@context.ElementId</MudTd>
        <MudTd DataLabel="Details">@(context.Details ?? context.Data)</MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <StudioStatePanel Title="No engine events found" Description="Persisted events for the active tenant will appear here." Icon="@Icons.Material.Outlined.ReceiptLong" />
    </NoRecordsContent>
</MudTable>
</MudPaper>
}

@code {
    private readonly List<HistoryEvent> _events = [];
    private bool _isLoading;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        EngineEventService.OnEventEmitted += HandleEventEmitted;
        TenantContext.Changed += OnTenantChanged;
        await LoadAsync();
    }

    public void Dispose()
    {
        EngineEventService.OnEventEmitted -= HandleEventEmitted;
        TenantContext.Changed -= OnTenantChanged;
    }

    private void OnTenantChanged() => _ = InvokeAsync(LoadAsync);

    private async void HandleEventEmitted(string eventMessage)
    {
        await InvokeAsync(LoadAsync);
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _error = null;
        try
        {
            var events = await HistoryService.GetHistoryAsync(TenantContext.CurrentTenantId);
            _events.Clear();
            _events.AddRange(events.OrderByDescending(historyEvent => historyEvent.Timestamp));
        }
        catch (Exception exception)
        {
            _events.Clear();
            _error = $"Event log could not be loaded: {exception.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private static string FormatEventType(string eventType) =>
        eventType.Replace('_', ' ').ToTitleCase();
}
