<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>vertexbpmn</ToolCommandName>
    <PackageId>VertexBPMN.Cli</PackageId>
    <Version>1.0.0</Version>
    <Authors>VertexBPMN</Authors>
    <Description>Command-line interface for the VertexBPMN process engine.</Description>
    <PackageTags>bpmn;workflow;process-automation;cli;vertexbpmn</PackageTags>
    <RepositoryUrl>https://github.com/VertexBPMN/VertexBPMN</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VertexBPMN.Domain\VertexBPMN.Domain.csproj" />
    <ProjectReference Include="..\VertexBPMN.Application\VertexBPMN.Application.csproj" />
    <ProjectReference Include="..\VertexBPMN.Engine\VertexBPMN.Engine.csproj" />
    <ProjectReference Include="..\VertexBPMN.Infrastructure\VertexBPMN.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
