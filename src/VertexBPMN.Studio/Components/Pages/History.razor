@page "/history"
@implements IDisposable
@inject IHistoryService HistoryService
@inject StudioTenantContext TenantContext

<PageTitle>History</PageTitle>

<StudioPageHeader Title="History"
                  Eyebrow="Analyze"
                  Description="Review persisted process and task events for the active tenant.">
    <Actions>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadAsync" Disabled="_isLoading">
            Refresh
        </MudButton>
    </Actions>
</StudioPageHeader>

@if (_error is not null)
{
    <StudioStatePanel Title="History could not be loaded"
                      Description="@_error"
                      Icon="@Icons.Material.Outlined.ErrorOutline">
        <Action>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="LoadAsync">Retry</MudButton>
        </Action>
    </StudioStatePanel>
}
else
{
<MudPaper Elevation="0" Class="studio-data-card">
    @if (_isLoading)
    {
        <MudProgressLinear Indeterminate="true" Class="mb-4" />
    }

    <MudTable Items="_events" Hover="true" Dense="true" Loading="_isLoading" Breakpoint="Breakpoint.Md" Class="studio-data-table">
        <HeaderContent>
            <MudTh>Timestamp</MudTh>
            <MudTh>Event</MudTh>
            <MudTh>Process instance</MudTh>
            <MudTh>Element</MudTh>
            <MudTh>Details</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Timestamp">@context.Timestamp.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</MudTd>
            <MudTd DataLabel="Event">@FormatEventType(context.EventType)</MudTd>
            <MudTd DataLabel="Process instance"><MudText Typo="Typo.caption" Class="studio-technical-id">@context.ProcessInstanceId</MudText></MudTd>
            <MudTd DataLabel="Element">@context.ElementId</MudTd>
            <MudTd DataLabel="Details">@context.Details</MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <StudioStatePanel Title="No history events found"
                              Description="Persisted runtime events for the active tenant will appear here."
                              Icon="@Icons.Material.Outlined.History" />
        </NoRecordsContent>
    </MudTable>
</MudPaper>
}

@code {
    private readonly List<HistoryEvent> _events = [];
    private bool _isLoading;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        TenantContext.Changed += OnTenantChanged;
        await LoadAsync();
    }

    private void OnTenantChanged() => _ = InvokeAsync(async () =>
    {
        await LoadAsync();
        StateHasChanged();
    });

    private async Task LoadAsync()
    {
        _isLoading = true;
        _error = null;
        try
        {
            var events = await HistoryService.GetHistoryAsync(TenantContext.CurrentTenantId);
            _events.Clear();
            _events.AddRange(events.OrderByDescending(historyEvent => historyEvent.Timestamp));
        }
        catch (Exception exception)
        {
            _events.Clear();
            _error = $"History could not be loaded: {exception.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    public void Dispose() => TenantContext.Changed -= OnTenantChanged;

    private static string FormatEventType(string? eventType) =>
        string.IsNullOrWhiteSpace(eventType)
            ? "Unknown"
            : eventType.Replace('_', ' ').ToTitleCase();
}
