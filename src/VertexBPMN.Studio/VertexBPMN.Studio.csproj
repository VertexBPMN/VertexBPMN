<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.12" />
    <PackageReference Include="Google.Protobuf" Version="3.36.2" />
    <PackageReference Include="Grpc.Net.Client" Version="2.83.0" />
    <PackageReference Include="Grpc.Tools" Version="2.84.0" PrivateAssets="All" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.10.0" />
    <PackageReference Include="MudBlazor" Version="9.10.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <PrivateAssets>All</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Azure.Extensions.AspNetCore.DataProtection.Blobs" Version="1.5.4" />
    <PackageReference Include="Azure.Extensions.AspNetCore.DataProtection.Keys" Version="1.6.4" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Azure.Core" Version="1.62.0" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.29.2" />
  </ItemGroup>


  <ItemGroup>
    <ProjectReference Include="..\VertexBPMN.Domain\VertexBPMN.Domain.csproj" />
    <ProjectReference Include="..\VertexBPMN.ServiceDefaults\VertexBPMN.ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="..\VertexBPMN.Api\Protos\vertexbpmn.proto" GrpcServices="Client" />
    <Protobuf Include="..\VertexBPMN.Api\Protos\vertexbpmn_mcp.proto" GrpcServices="Client" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="wwwroot\data\DefaultBpmn.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Update="wwwroot\data\DefaultCmmn.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Update="wwwroot\data\DefaultDmn.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Update="wwwroot\data\invoiceApprovalForm.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <Target Name="BuildBpmnIoAssets" BeforeTargets="Build" Condition="'$(SkipBpmnIoAssetBuild)' != 'true'" Inputs="package-lock.json;package.json;tools/bpmn-io/build-bpmn-io-assets.mjs;@(BpmnIoAssetSource)" Outputs="wwwroot/lib/bpmn-js/bpmn-modeler.js;wwwroot/lib/dmn-js/dmn-modeler.js;wwwroot/lib/form-js/form-editor.js;wwwroot/lib/cmmn-js/cmmn-modeler.js">
    <Message Importance="high" Text="Building pinned bpmn.io Studio assets from npm packages..." />
    <Exec Command="npm ci" />
    <Exec Command="npm run build:bpmnio" />
  </Target>

  <ItemGroup>
    <BpmnIoAssetSource Include="tools/bpmn-io/src/**/*.js" />
  </ItemGroup>

</Project>
