{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "BpmnDbContext": "Data Source=dev-bpmn.db",
    "TenantDbContext": "Data Source=dev-tenants.db",
    "SimulationScenarioDbContext": "Data Source=dev-sim.db",
    "ProcessMiningEvents": "Data Source=dev-events.db",
    "DecisionDbContext": "Data Source=dev-decision.db"
  },
  "McpAgents": [
    {
      "name": "NLP",
      "type": "REST",
      "url": "http://localhost:5000/api/nlp",
      "auth": null
    },
    {
      "name": "Recommender",
      "type": "REST",
      "url": "http://localhost:5000/api/recommend",
      "auth": null
    },
    {
      "name": "HumanInLoop",
      "type": "REST",
      "url": "http://localhost:5000/api/review",
      "auth": null
    }
  ],
  "PathBase": "/api",
