@page "/event-log"
@inject VertexBPMN.Studio.Services.IEngineEventService EngineEventService
@implements IDisposable

<PageTitle>Event Log</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Event Log</MudText>

<MudList T="string">
    @foreach (var logEntry in _eventLog.AsEnumerable().Reverse())
    {
        <MudListItem T="string" Icon="@Icons.Material.Filled.Event">@logEntry</MudListItem>
    }
</MudList>

@code {
    private List<string> _eventLog = new List<string>();

    protected override void OnInitialized()
    {
        EngineEventService.OnEventEmitted += HandleEventEmitted;
    }

    public void Dispose()
    {
        EngineEventService.OnEventEmitted -= HandleEventEmitted;
    }

    private void HandleEventEmitted(string eventMessage)
    {
        _eventLog.Add($"{DateTime.Now} [Source: Studio]: {eventMessage}");
        StateHasChanged();
    }
}