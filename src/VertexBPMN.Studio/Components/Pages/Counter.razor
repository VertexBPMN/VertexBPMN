@page "/counter"
@rendermode InteractiveServer

<PageTitle>Counter</PageTitle>

<StudioPageHeader Title="Counter" Eyebrow="Demo" Description="Interactive template page retained for development diagnostics." />

<MudPaper Class="studio-content-card" Elevation="0">
    <MudText Typo="Typo.h6" role="status">Current count: @currentCount</MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="IncrementCount" Class="mt-4">Increment</MudButton>
</MudPaper>

@code {
    private int currentCount = 0;

    private void IncrementCount()
    {
        currentCount++;
    }
}
