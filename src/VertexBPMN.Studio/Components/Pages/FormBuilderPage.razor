@page "/form-builder"
@inject MudBlazor.ISnackbar Snackbar
@inject IHttpClientFactory HttpClientFactory
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

<PageTitle>Form Builder</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Form Builder</MudText>

<MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveFormJson">Save JSON</MudButton>
<MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="LoadFormJson">Load JSON</MudButton>

<div id="@_containerId" style="height:500px; border:1px solid #ccc;"></div>

@code {
    private string _formJson = string.Empty;
    private HttpClient _httpClient;

    private string _containerId = $"form-builder-{Guid.NewGuid():N}";
    private IJSObjectReference? _module;
    private IJSObjectReference? _formInstance;
    private bool _initialized;

    protected override async Task OnInitializedAsync()
    {
        _httpClient = HttpClientFactory.CreateClient("Default");
        await LoadFormJson();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/form-builder.js");
            _formInstance = await _module.InvokeAsync<IJSObjectReference>("FormBuilderInterop.createForm", _containerId, _formJson);
            _initialized = true;
        }
    }

    private async Task SaveFormJson()
    {
        if (_module == null || _formInstance == null)
        {
            Snackbar.Add("Form builder not initialized yet", Severity.Warning);
            return;
        }
        var json = await _module.InvokeAsync<string>("FormBuilderInterop.getJson", _formInstance);
        Snackbar.Add("Form persistence is not supported by the API yet.", Severity.Warning);
    }

    private async Task LoadFormJson()
    {
        _formJson = await _httpClient.GetStringAsync("data/invoiceApprovalForm.json");
        Snackbar.Add("Form JSON loaded!", Severity.Info);
        if (_initialized && _module != null && _formInstance != null)
        {
            await _module.InvokeVoidAsync("FormBuilderInterop.loadJson", _formInstance, _formJson);
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_formInstance is not null)
            {
                await _formInstance.DisposeAsync();
            }
            if (_module is not null)
            {
                await _module.DisposeAsync();
            }
        }
        catch { }
    }
}
