@inject IJSRuntime JSRuntime
@inject ILogger<BpmnViewerDialog> Logger
@implements IDisposable

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6" Class="studio-dialog-title">
            <MudIcon Icon="@Icons.Material.Filled.Visibility" Class="mr-3"/>
            @Title
        </MudText>
    </TitleContent>
    <DialogContent>
        <div class="studio-dialog-viewer">
            @if (string.IsNullOrEmpty(BpmnXml))
            {
                <MudAlert Severity="Severity.Warning">
                    No BPMN XML available to display.
                </MudAlert>
            }
            else
            {
                <div id="@_viewerContainerId" class="studio-dialog-viewer__canvas"></div>
            }
        </div>
        @if (!string.IsNullOrEmpty(BpmnXml))
        {
            <MudTextField Value="@BpmnXml"
                          Label="BPMN XML"
                          ReadOnly="true"
                          Lines="8"
                          data-testid="bpmn-definition-xml"
                          Class="mt-4" />
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => Dialog.Close())" Variant="Variant.Text">
            Close
        </MudButton>
        <MudButton OnClick="DownloadXml"
                  Color="Color.Primary"
                  Variant="Variant.Filled"
                  StartIcon="@Icons.Material.Filled.Download">
            Download XML
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] public MudBlazor.IMudDialogInstance Dialog { get; set; } = default!;
    [Parameter] public string BpmnXml { get; set; } = string.Empty;
    [Parameter] public string Title { get; set; } = "BPMN Viewer";

    private string _viewerContainerId = $"bpmn-viewer-{Guid.NewGuid().ToString().Replace("-", "")}";
    private IJSObjectReference? _module;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !string.IsNullOrEmpty(BpmnXml))
        {
            try
            {
                _module = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/bpmn-viewer.js");
                await _module.InvokeVoidAsync("BpmnViewerInterop.createViewer", _viewerContainerId, BpmnXml);
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Error initializing BPMN viewer");
            }
        }
    }

    private async Task DownloadXml()
    {
        if (string.IsNullOrEmpty(BpmnXml)) return;

        try
        {
            var fileName = $"process-definition-{DateTime.Now:yyyyMMdd-HHmmss}.bpmn";
            var bytes = System.Text.Encoding.UTF8.GetBytes(BpmnXml);
            var base64 = Convert.ToBase64String(bytes);
            var dataUri = $"data:application/xml;base64,{base64}";
            
            await JSRuntime.InvokeVoidAsync("downloadFile", fileName, dataUri);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error downloading BPMN XML");
        }
    }

    public void Dispose()
    {
        _module?.DisposeAsync();
    }
}
