@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

<div class="bpmn-modeler-workspace">
<div class="bpmn-modeler-mobile-actions">
    <MudButton Variant="Variant.Outlined"
               Size="Size.Small"
               StartIcon="@Icons.Material.Outlined.Tune"
               aria-expanded="@(_propertiesOpen ? "true" : "false")"
               aria-controls="@_propertiesPanelId"
               OnClick="ToggleProperties">
        @(_propertiesOpen ? "Hide properties" : "Show properties")
    </MudButton>
</div>
<div class="bpmn-io-shell" data-testid="bpmn-modeler-shell">
    <div id="@_canvasId" class="bpmn-io-canvas"><div class="bpmn-io-canvas-placeholder">BPMN modeler canvas</div></div>
    <div id="@_propertiesPanelId" class="bpmn-io-properties-panel @PropertiesPanelClass" aria-label="BPMN properties panel">
        <MudText Typo="Typo.subtitle2">Properties Panel</MudText>
        <MudText Typo="Typo.caption">Select an element to edit its BPMN metadata.</MudText>
    </div>
</div>
</div>

@code {
    [Parameter] public string Xml { get; set; } = string.Empty;
    [Parameter] public IReadOnlyList<StudioConnectorTemplate> ConnectorTemplates { get; set; } = [];
    [Parameter] public IReadOnlyList<StudioDecisionOption> DecisionOptions { get; set; } = [];

    private readonly string _canvasId = $"bpmn-modeler-{Guid.NewGuid():N}";
    private readonly string _propertiesPanelId = $"bpmn-properties-{Guid.NewGuid():N}";
    private IJSObjectReference? _module;
    private IJSObjectReference? _modeler;
    private string _loadedXml = string.Empty;
    private bool _initialized;
    private bool _propertiesOpen;
    private bool _resizePending;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            if (_resizePending && _module is not null && _modeler is not null)
            {
                _resizePending = false;
                await _module.InvokeVoidAsync("BpmnModelerInterop.resize", _modeler);
            }
            return;
        }

        _module = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/bpmn-modeler.js");
        _modeler = await _module.InvokeAsync<IJSObjectReference>("BpmnModelerInterop.createModeler", _canvasId, Xml, _propertiesPanelId);
        _loadedXml = Xml;
        _initialized = true;
        await ConfigureQuickInsertAsync(ConnectorTemplates);
        await ConfigureDecisionPickerAsync(DecisionOptions);
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_initialized && _module is not null && _modeler is not null && Xml != _loadedXml)
        {
            await _module.InvokeVoidAsync("BpmnModelerInterop.loadXml", _modeler, Xml);
            _loadedXml = Xml;
        }

        if (_initialized)
        {
            await ConfigureQuickInsertAsync(ConnectorTemplates);
            await ConfigureDecisionPickerAsync(DecisionOptions);
        }
    }

    public async Task InsertConnectorTemplateAsync(StudioConnectorTemplate template, IReadOnlyDictionary<string, string>? values = null)
    {
        if (_module is null || _modeler is null)
            return;

        await _module.InvokeVoidAsync("BpmnModelerInterop.insertConnectorTemplate", _modeler, template, values);
        _loadedXml = await GetXmlAsync();
    }

    public async Task InsertLowCodeNodeAsync(string nodeKind)
    {
        if (_module is null || _modeler is null)
            return;

        await _module.InvokeVoidAsync("BpmnModelerInterop.insertLowCodeNode", _modeler, nodeKind);
        _loadedXml = await GetXmlAsync();
    }

    public async Task InsertLowCodePatternAsync(string patternId)
    {
        if (_module is null || _modeler is null)
            return;

        await _module.InvokeVoidAsync("BpmnModelerInterop.insertLowCodePattern", _modeler, patternId);
        _loadedXml = await GetXmlAsync();
    }

    public async Task ConfigureQuickInsertAsync(IReadOnlyList<StudioConnectorTemplate> templates)
    {
        if (_module is null || _modeler is null)
            return;

        await _module.InvokeVoidAsync("BpmnModelerInterop.configureQuickInsert", _modeler, templates);
    }

    public async Task ConfigureDecisionPickerAsync(IReadOnlyList<StudioDecisionOption> decisions)
    {
        if (_module is null)
            return;

        await _module.InvokeVoidAsync("BpmnModelerInterop.configureDecisionPicker", decisions);
    }

    public async Task<string> GetXmlAsync()
    {
        if (_module is null || _modeler is null)
            return Xml;

        var xml = await _module.InvokeAsync<string>("BpmnModelerInterop.getXml", _modeler);
        _loadedXml = xml;
        return xml;
    }

    public async Task<IReadOnlyList<StudioValidationIssue>> GetValidationIssuesAsync()
    {
        if (_module is null || _modeler is null)
            return [new StudioValidationIssue("DEP-VALIDATOR-UNAVAILABLE", "error", null, "The BPMN editor is still loading.")];

        return await _module.InvokeAsync<StudioValidationIssue[]>("BpmnModelerInterop.getValidationIssues", _modeler);
    }

    public async Task FocusElementAsync(string? elementId)
    {
        if (_module is not null && _modeler is not null && elementId is not null)
            await _module.InvokeVoidAsync("BpmnModelerInterop.focusElement", _modeler, elementId);
    }

    public Task StartSimulationAsync() => InvokeSimulationActionAsync("BpmnModelerInterop.startSimulation");

    public Task PauseSimulationAsync() => InvokeSimulationActionAsync("BpmnModelerInterop.pauseSimulation");

    public Task ResetSimulationAsync() => InvokeSimulationActionAsync("BpmnModelerInterop.resetSimulation");

    private void ToggleProperties()
    {
        _propertiesOpen = !_propertiesOpen;
        _resizePending = true;
    }

    private string? PropertiesPanelClass => _propertiesOpen ? "bpmn-io-properties-panel--open" : null;

    private async Task InvokeSimulationActionAsync(string identifier)
    {
        if (_module is not null && _modeler is not null)
            await _module.InvokeVoidAsync(identifier, _modeler);
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_module is not null && _modeler is not null)
                await _module.InvokeVoidAsync("BpmnModelerInterop.destroy", _modeler);
            if (_module is not null)
                await _module.DisposeAsync();
        }
        catch
        {
            // Ignore browser-disconnect cleanup errors.
        }
    }
}
