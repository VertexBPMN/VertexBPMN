@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

<div id="@_viewerContainerId" class="bpmn-runtime-viewer" data-testid="bpmn-runtime-viewer"></div>

@code {
    [Parameter] public string BpmnXml { get; set; } = string.Empty;
    [Parameter] public IReadOnlyList<string> ActiveElementIds { get; set; } = [];
    [Parameter] public IReadOnlyList<string> CompletedElementIds { get; set; } = [];
    [Parameter] public IReadOnlyList<string> FailedElementIds { get; set; } = [];
    [Parameter] public IReadOnlyList<string> WaitingElementIds { get; set; } = [];
    [Parameter] public IReadOnlyList<string> RetryElementIds { get; set; } = [];
    [Parameter] public string? ReplayElementId { get; set; }

    private readonly string _viewerContainerId = $"bpmn-viewer-{Guid.NewGuid():N}";
    private IJSObjectReference? _module;
    private IJSObjectReference? _viewer;
    private string _loadedXml = string.Empty;
    private string _runtimeStateFingerprint = string.Empty;
    private bool _initialized;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        _module = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/bpmn-viewer.js");
        _viewer = await _module.InvokeAsync<IJSObjectReference>("BpmnViewerInterop.createViewer", _viewerContainerId, BpmnXml);
        _loadedXml = BpmnXml;
        _initialized = true;
        await ApplyRuntimeStateAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!_initialized || _module is null || _viewer is null)
            return;

        if (BpmnXml != _loadedXml)
        {
            await _module.InvokeVoidAsync("BpmnViewerInterop.loadXml", _viewer, BpmnXml);
            _loadedXml = BpmnXml;
        }

        await ApplyRuntimeStateAsync();
    }

    private async Task ApplyRuntimeStateAsync()
    {
        if (_module is null || _viewer is null)
            return;

        var state = new
        {
            active = ActiveElementIds,
            completed = CompletedElementIds,
            failed = FailedElementIds,
            waiting = WaitingElementIds,
            retry = RetryElementIds,
            replay = string.IsNullOrWhiteSpace(ReplayElementId) ? [] : new[] { ReplayElementId }
        };
        var fingerprint = string.Join('|', state.active.Concat(state.completed).Concat(state.failed).Concat(state.waiting).Concat(state.retry).Concat(state.replay));
        if (fingerprint == _runtimeStateFingerprint)
            return;

        await _module.InvokeVoidAsync("BpmnViewerInterop.setRuntimeState", _viewer, state);
        _runtimeStateFingerprint = fingerprint;
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_module is not null && _viewer is not null)
                await _module.InvokeVoidAsync("BpmnViewerInterop.destroy", _viewer);
            if (_module is not null)
                await _module.DisposeAsync();
        }
        catch
        {
            // Browser shutdown can dispose the JS runtime first.
        }
    }
}
