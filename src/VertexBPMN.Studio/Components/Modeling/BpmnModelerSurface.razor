@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

<div class="bpmn-io-shell" data-testid="bpmn-modeler-shell">
    <div id="@_canvasId" class="bpmn-io-canvas"><div class="bpmn-io-canvas-placeholder">BPMN modeler canvas</div></div>
    <div id="@_propertiesPanelId" class="bpmn-io-properties-panel" aria-label="BPMN properties panel">
        <MudText Typo="Typo.subtitle2">Properties Panel</MudText>
        <MudText Typo="Typo.caption">Select an element to edit its BPMN metadata.</MudText>
    </div>
</div>

@code {
    [Parameter] public string Xml { get; set; } = string.Empty;

    private readonly string _canvasId = $"bpmn-modeler-{Guid.NewGuid():N}";
    private readonly string _propertiesPanelId = $"bpmn-properties-{Guid.NewGuid():N}";
    private IJSObjectReference? _module;
    private IJSObjectReference? _modeler;
    private string _loadedXml = string.Empty;
    private bool _initialized;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        _module = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/bpmn-modeler.js");
        _modeler = await _module.InvokeAsync<IJSObjectReference>("BpmnModelerInterop.createModeler", _canvasId, Xml, _propertiesPanelId);
        _loadedXml = Xml;
        _initialized = true;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_initialized && _module is not null && _modeler is not null && Xml != _loadedXml)
        {
            await _module.InvokeVoidAsync("BpmnModelerInterop.loadXml", _modeler, Xml);
            _loadedXml = Xml;
        }
    }

    public async Task<string> GetXmlAsync()
    {
        if (_module is null || _modeler is null)
            return Xml;

        var xml = await _module.InvokeAsync<string>("BpmnModelerInterop.getXml", _modeler);
        _loadedXml = xml;
        return xml;
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_module is not null && _modeler is not null)
                await _module.InvokeVoidAsync("BpmnModelerInterop.destroy", _modeler);
            if (_module is not null)
                await _module.DisposeAsync();
        }
        catch
        {
            // Ignore browser-disconnect cleanup errors.
        }
    }
}
