{
  "AdvancedFeatures": {
    "SimulationExecution": false,
    "LiveProcessMigration": false,
    "CmmnExecution": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "BpmnDbContext": "",
    "TenantDbContext": "",
    "SimulationScenarioDbContext": "",
    "ProcessMiningEvents": "",
    "DecisionDbContext": ""
  },
  "McpAgents": [
    {
      "name": "NLP",
      "type": "REST",
      "url": "http://localhost:5000/api/nlp",
      "auth": null
    },
    {
      "name": "Recommender",
      "type": "REST",
      "url": "http://localhost:5000/api/recommend",
      "auth": null
    },
    {
      "name": "HumanInLoop",
      "type": "REST",
      "url": "http://localhost:5000/api/review",
      "auth": null
    }
  ],
  "PathBase": "/api",
  "OperationalMode": "Stage",
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "Runtime": {
    "Outbox": {
      "Enabled": false,
      "Provider": "Disabled",
      "Destination": "vertexbpmn-runtime"
    }

    // Azure Service Bus example (P1). Uncomment + fill placeholders to switch the runtime outbox provider; Managed Identity needs no ConnectionString. Never commit real names or secrets.
    // "Outbox": {
    //   "Enabled": true,
    //   "Provider": "AzureServiceBus",
    //   "Destination": "vertexbpmn-runtime",
    //   "FullyQualifiedNamespace": "<yourns>.servicebus.windows.net",
    //   "EntityName": "vertexbpmn-runtime",
    //   "EntityType": "Topic",
    //   "AuthenticationMode": "ManagedIdentity",
    //   "ManagedIdentityClientId": "<user-assigned-client-id>",
    //   "OperationTimeoutSeconds": 60
    // }
  },
  "Telemetry": {
    "ConsoleExporter": false
  },
  "Modules": {
    "Swagger": true,
    "Telemetry": true,
    "Plugins": false,
    "BackgroundJobs": true
  },
  "RateLimiting": {
    "PermitLimit": 120,
    "WindowSeconds": 60,
    "QueueLimit": 0
  },
  "Webhooks": {
    "SigningSecret": "",
    "Endpoints": []
  },
  "Notifications": {
    "Email": {
      "Enabled": false,
      "From": "noreply@example.com",
      "SmtpHost": "smtp.example.com",
      "Port": 587,
      "UseSsl": true,
      "Username": "smtp-user",
      "Password": "",
      "DefaultRecipients": [ "ops@example.com", "audit@example.com" ]
    }
  }
}
