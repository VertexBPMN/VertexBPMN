@page "/form-builder"
@using System.Text
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Forms
@inject MudBlazor.ISnackbar Snackbar
@inject IJSRuntime JSRuntime
@inject IFormDefinitionService FormService
@inject StudioTenantContext TenantContext
@inject IWebHostEnvironment HostEnvironment

<PageTitle>Form Builder</PageTitle>

<MudStack Spacing="3" Class="studio-editor-page">
    <StudioPageHeader Title="Form Builder"
                      Eyebrow="Model"
                      Description="Build, preview and publish forms for user tasks." />

    <StudioToolbar AriaLabel="Form model actions" Class="studio-editor-toolbar">
            <MudTextField Label="Form key" @bind-Value="_formKey" Required="true" Immediate="true" />
            <MudTextField Label="Form name" @bind-Value="_formName" Required="true" Immediate="true" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveFormJson" StartIcon="@Icons.Material.Filled.Save">Save form</MudButton>
            <label class="mud-button-root mud-button mud-button-outlined mud-button-outlined-primary mud-button-outlined-size-medium mud-ripple" for="form-import-file">
                <MudIcon Icon="@Icons.Material.Filled.UploadFile" Size="Size.Small" Class="me-2" />
                Import JSON
            </label>
            <InputFile id="form-import-file" data-testid="form-import-file" OnChange="ImportFormJsonAsync" accept=".json,.form,application/json" style="display:none" />
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="ExportFormJson" StartIcon="@Icons.Material.Filled.Download">Export JSON</MudButton>
            <MudButton Variant="Variant.Outlined" OnClick="LoadSavedFormJson" StartIcon="@Icons.Material.Filled.CloudDownload">Load saved form</MudButton>
            <MudButton Variant="Variant.Outlined" OnClick="@(() => LoadFormJson())" StartIcon="@Icons.Material.Filled.Refresh">Load JSON</MudButton>
            <MudSelect T="int" Label="Published revision" @bind-Value="_selectedVersion" Disabled="@(_revisions.Count == 0)">
                @foreach (var revision in _revisions)
                {
                    <MudSelectItem T="int" Value="@revision.Version">Revision @revision.Version · @revision.SchemaHash</MudSelectItem>
                }
            </MudSelect>
            <MudButton Variant="Variant.Outlined" OnClick="LoadSelectedRevisionAsync" Disabled="@(_selectedVersion < 1)">Load selected revision</MudButton>
            <MudChip T="string" Color="Color.Info" Variant="Variant.Outlined">Tenant: @(TenantContext.CurrentTenantId ?? "select tenant")</MudChip>
    </StudioToolbar>

    <MudPaper Class="studio-modeler-card" Elevation="0">
        <div class="studio-modeler-card__header">
            <div>
                <MudText Typo="Typo.h6">Form canvas</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">Arrange fields and edit their form-js configuration.</MudText>
            </div>
            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Icon="@Icons.Material.Outlined.Edit">Editing</MudChip>
        </div>
        <FormBuilderSurface @ref="_builder" Json="@_formJson" />
    </MudPaper>

    <div class="studio-bpmn-tools studio-editor-tools">
        <div class="studio-bpmn-tools__tabs" role="tablist" aria-label="Form tools">
            <button type="button" role="tab" aria-selected="@AriaSelected(0)" class="studio-bpmn-tools__tab @ToolTabClass(0)" @onclick="@(() => _activeToolTab = 0)"><MudIcon Icon="@Icons.Material.Outlined.AddBox" Size="Size.Small" />Field tools</button>
            <button type="button" role="tab" aria-selected="@AriaSelected(1)" class="studio-bpmn-tools__tab @ToolTabClass(1)" @onclick="@(() => _activeToolTab = 1)"><MudIcon Icon="@Icons.Material.Outlined.Visibility" Size="Size.Small" />Runtime Viewer</button>
        </div>
        <div class="studio-bpmn-tools__panels">
            <section role="tabpanel" hidden="@(_activeToolTab != 0)">
                <MudStack Spacing="3" Class="studio-bpmn-tool-panel">
                    <div>
                        <MudText Typo="Typo.h6">Add text field</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Create a bound field with a stable schema key and user-facing label.</MudText>
                    </div>
                    <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2">
                        <MudTextField Label="New field key" @bind-Value="_newFieldKey" Immediate="true" />
                        <MudTextField Label="New field label" @bind-Value="_newFieldLabel" Immediate="true" />
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="AddTextFieldAsync" Disabled="@(string.IsNullOrWhiteSpace(_newFieldKey) || string.IsNullOrWhiteSpace(_newFieldLabel))">Add text field</MudButton>
                    </MudStack>
                </MudStack>
            </section>
            <section role="tabpanel" hidden="@(_activeToolTab != 1)">
                <div class="studio-bpmn-tool-panel studio-bpmn-tool-panel--viewer">
                    @if (_activeToolTab == 1)
                    {
                        <FormViewerSurface Json="@_savedFormJson" />
                    }
                </div>
            </section>
        </div>
    </div>
</MudStack>

@code {
    private string _formJson = FallbackFormJson;
    private string _savedFormJson = FallbackFormJson;
    private FormBuilderSurface? _builder;
    private string _formKey = "invoice-approval";
    private string _formName = "Invoice approval";
    private string? _formId;
    private IReadOnlyList<StudioFormRevision> _revisions = [];
    private int _selectedVersion;
    private string? _formTenantId;
    private string _newFieldKey = string.Empty;
    private string _newFieldLabel = string.Empty;
    private int _activeToolTab;

    private string? ToolTabClass(int index) => _activeToolTab == index ? "studio-bpmn-tools__tab--active" : null;

    private string AriaSelected(int index) => _activeToolTab == index ? "true" : "false";

    private const string FallbackFormJson = """
{
  "type": "default",
  "components": [
    {
      "key": "invoiceNumber",
      "label": "Invoice number",
      "type": "textfield"
    }
  ]
}
""";

    protected override async Task OnInitializedAsync()
    {
        await LoadFormJson(showNotification: false);
    }

    private async Task SaveFormJson()
    {
        _formJson = await CaptureFormJson();
        _savedFormJson = _formJson;
        if (string.IsNullOrWhiteSpace(TenantContext.CurrentTenantId)) { Snackbar.Add("Select a tenant before saving the form.", Severity.Warning); return; }
        var request = new StudioFormWriteRequest(TenantContext.CurrentTenantId, _formKey, _formName, _formJson);
        try
        {
            if (_formId is not null && !string.Equals(_formTenantId, request.TenantId, StringComparison.Ordinal))
                throw new InvalidOperationException("Reload the form after changing tenant.");
            if (_formId is null) _formId = (await FormService.CreateAsync(request)).Id;
            else await FormService.UpdateAsync(_formId, request);
            _formTenantId = request.TenantId;
            await RefreshRevisionsAsync();
            Snackbar.Add("Form saved as an immutable revision and refreshed in the Runtime Viewer.", Severity.Success);
        }
        catch (Exception ex) { Snackbar.Add($"Form save failed: {ex.Message}", Severity.Error); }
    }

    private async Task AddTextFieldAsync()
    {
        if (_builder is null || string.IsNullOrWhiteSpace(_newFieldKey) || string.IsNullOrWhiteSpace(_newFieldLabel))
            return;

        await _builder.AddTextFieldAsync(_newFieldKey.Trim(), _newFieldLabel.Trim());
        _formJson = await _builder.GetJsonAsync();
        Snackbar.Add("Text field added to the form.", Severity.Success);
    }

    private async Task ImportFormJsonAsync(InputFileChangeEventArgs args)
    {
        var file = args.File;
        if (file.Size > 10 * 1024 * 1024)
        {
            Snackbar.Add("Form JSON exceeds the 10 MB limit.", Severity.Error);
            return;
        }

        await using var stream = StudioModelUpload.OpenReadStream(file);
        using var reader = new StreamReader(stream);
        var json = await reader.ReadToEndAsync();
        try
        {
            using var _ = JsonDocument.Parse(json);
            _formJson = json;
            _savedFormJson = json;
            _formId = null;
            _formTenantId = null;
            _revisions = [];
            _selectedVersion = 0;
            Snackbar.Add($"Imported {file.Name}.", Severity.Success);
        }
        catch (JsonException exception)
        {
            Snackbar.Add($"Form import failed: {exception.Message}", Severity.Error);
        }
    }

    private async Task LoadSavedFormJson()
    {
        if (string.IsNullOrWhiteSpace(TenantContext.CurrentTenantId))
        {
            Snackbar.Add("Select a tenant before loading a saved form.", Severity.Warning);
            return;
        }

        var definition = (await FormService.ListAsync(TenantContext.CurrentTenantId))
            .Where(candidate => candidate.Key.Equals(_formKey, StringComparison.Ordinal))
            .OrderByDescending(candidate => candidate.Version)
            .FirstOrDefault();
        if (definition is null)
        {
            Snackbar.Add($"No saved form found for '{_formKey}'.", Severity.Warning);
            return;
        }

        _formId = definition.Id;
        _formName = definition.Name;
        _formJson = definition.Schema;
        _savedFormJson = definition.Schema;
        _formTenantId = definition.TenantId;
        await RefreshRevisionsAsync();
        Snackbar.Add("Saved form loaded from the registry.", Severity.Success);
    }

    private async Task RefreshRevisionsAsync()
    {
        if (_formId is null || _formTenantId is null) return;
        _revisions = await FormService.GetRevisionsAsync(_formId, _formTenantId);
        _selectedVersion = _revisions.Select(revision => revision.Version).DefaultIfEmpty(0).Max();
    }

    private async Task LoadSelectedRevisionAsync()
    {
        if (_formId is null || _formTenantId is null || _selectedVersion < 1) return;
        try
        {
            if (!string.Equals(_formTenantId, TenantContext.CurrentTenantId, StringComparison.Ordinal))
                throw new InvalidOperationException("Reload the form after changing tenant.");
            var revision = await FormService.GetRevisionAsync(_formId, _selectedVersion, _formTenantId)
                ?? throw new InvalidOperationException("The selected revision is unavailable.");
            _formJson = revision.Schema;
            _savedFormJson = revision.Schema;
            Snackbar.Add($"Loaded immutable revision {revision.Version}. Saving publishes a new revision.", Severity.Info);
        }
        catch (Exception ex) { Snackbar.Add($"Revision load failed: {ex.Message}", Severity.Error); }
    }

    private async Task ExportFormJson()
    {
        _formJson = await CaptureFormJson();
        await DownloadTextAsync("studio-form.form.json", _formJson, "application/json");
        Snackbar.Add("Form JSON exported.", Severity.Success);
    }

    private async Task LoadFormJson(bool showNotification = true)
    {
        try
        {
            var templatePath = Path.Combine(HostEnvironment.WebRootPath, "data", "invoiceApprovalForm.json");
            _formJson = await File.ReadAllTextAsync(templatePath);
            _savedFormJson = _formJson;
            if (showNotification)
                Snackbar.Add("Form JSON loaded.", Severity.Info);
        }
        catch (Exception ex)
        {
            _formJson = FallbackFormJson;
            _savedFormJson = _formJson;
            if (showNotification)
                Snackbar.Add($"Form template not found. Using fallback. ({ex.Message})", Severity.Warning);
        }
    }

    private async Task<string> CaptureFormJson()
    {
        if (_builder is not null)
            _formJson = await _builder.GetJsonAsync();
        return _formJson;
    }

    private async Task DownloadTextAsync(string fileName, string content, string contentType)
    {
        var dataUri = $"data:{contentType};base64,{Convert.ToBase64String(Encoding.UTF8.GetBytes(content))}";
        await JSRuntime.InvokeVoidAsync("downloadFile", fileName, dataUri);
    }
}
