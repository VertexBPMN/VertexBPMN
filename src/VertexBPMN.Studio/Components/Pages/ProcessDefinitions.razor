@page "/process-definitions"
@inject VertexBPMN.Studio.Services.IRepositoryService RepositoryService
@inject VertexBPMN.Studio.Services.ActiveEngineService ActiveEngineService
@inject VertexBPMN.Studio.Services.StudioTenantContext TenantContext
@inject MudBlazor.IDialogService DialogService
@inject MudBlazor.ISnackbar Snackbar
@implements IDisposable

<PageTitle>Process Definitions</PageTitle>

<StudioPageHeader Title="Process Definitions"
                  Eyebrow="Work"
                  Description="Browse deployed process versions, inspect their BPMN and start new instances." />

@if (_isLoading)
{
    <StudioStatePanel Title="Loading process definitions"
                      Description="Reading deployed definitions for the active tenant."
                      Icon="@Icons.Material.Outlined.HourglassTop" />
}
else
{
    @if (_error != null)
    {
        <StudioStatePanel Title="Process definitions could not be loaded"
                          Description="@_error"
                          Icon="@Icons.Material.Outlined.ErrorOutline">
            <Action>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="LoadProcessDefinitions">Retry</MudButton>
            </Action>
        </StudioStatePanel>
    }
    else
    {
    <MudPaper Class="studio-data-card" Elevation="0">
    <MudDataGrid T="ProcessDefinition"
                 Items="@FilteredDefinitions"
                 @bind-CurrentPage="_currentPage"
                 Filterable="true"
                 Groupable="true"
                 Hover="true"
                 Dense="true"
                 data-testid="process-definitions-grid"
                 Class="studio-data-table">
        <ToolBarContent>
            <MudTextField T="string" Value="@_search" ValueChanged="OnSearchChanged" Immediate="true" Placeholder="Search definitions" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Clearable="true" Class="studio-table-search" data-testid="process-definition-search" />
            <MudSpacer />
            <MudButton Variant="Variant.Outlined"
                      Color="Color.Primary"
                      StartIcon="@Icons.Material.Filled.Refresh"
                      OnClick="RefreshData">
                Refresh
            </MudButton>
        </ToolBarContent>
        <Columns>
            <PropertyColumn Property="x => x.Key" Title="Key" />
            <PropertyColumn Property="x => x.Name" Title="Name" />
            <PropertyColumn Property="x => x.Version" Title="Version" />
            <TemplateColumn Title="Deployment" Sortable="false">
                <CellTemplate>
                    @if (context.Item.DeploymentId != Guid.Empty)
                    {
                        <MudText Typo="Typo.caption" Class="studio-technical-id">
                            @context.Item.DeploymentId.ToString("N")[..8]...
                        </MudText>
                    }
                    else
                    {
                        <MudText Typo="Typo.body2" Color="Color.Tertiary">N/A</MudText>
                    }
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Tenant" Sortable="false">
                <CellTemplate>
                    <MudText Typo="Typo.body2">
                        @(context.Item.TenantId ?? "Default")
                    </MudText>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Actions" Sortable="false">
                <CellTemplate>
                    <MudButtonGroup Size="Size.Small" Variant="Variant.Text">
                        <MudIconButton Icon="@Icons.Material.Filled.Visibility" 
                                      Size="Size.Small" 
                                      OnClick="@(() => ViewDefinition(context.Item))" 
                                      aria-label="View BPMN" />
                        <MudIconButton Icon="@Icons.Material.Filled.PlayArrow" 
                                      Size="Size.Small" 
                                      Color="Color.Success"
                                      OnClick="@(() => StartProcess(context.Item))" 
                                      aria-label="Start Process Instance" />
                        <MudIconButton Icon="@Icons.Material.Filled.History" 
                                      Size="Size.Small" 
                                      OnClick="@(() => ViewVersions(context.Item.Key))" 
                                      aria-label="View Versions" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                      Size="Size.Small"
                                      Color="Color.Error"
                                      OnClick="@(() => DeleteDefinition(context.Item))"
                                      aria-label="Delete Process Definition" />
                    </MudButtonGroup>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <PagerContent>
            <MudDataGridPager T="ProcessDefinition" />
        </PagerContent>
        <NoRecordsContent>
            <StudioStatePanel Title="No process definitions found"
                              Description="Deploy a BPMN file or adjust the current search and filters."
                              Icon="@Icons.Material.Outlined.AccountTree" />
        </NoRecordsContent>
    </MudDataGrid>
    </MudPaper>
    }
}

@code {
    private List<ProcessDefinition> _processDefinitions = new();
    private bool _isLoading = true;
    private string? _error;
    private string _search = string.Empty;
    private int _currentPage;

    private IEnumerable<ProcessDefinition> FilteredDefinitions =>
        string.IsNullOrWhiteSpace(_search)
            ? _processDefinitions
            : _processDefinitions.Where(definition =>
                definition.Key.Contains(_search, StringComparison.OrdinalIgnoreCase)
                || definition.Name.Contains(_search, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        ActiveEngineService.OnChange += StateHasChanged;
        TenantContext.Changed += OnTenantChanged;
        await LoadProcessDefinitions();
    }

    public void Dispose()
    {
        ActiveEngineService.OnChange -= StateHasChanged;
        TenantContext.Changed -= OnTenantChanged;
    }

    private void OnTenantChanged() => _ = InvokeAsync(LoadProcessDefinitions);

    private async Task OnSearchChanged(string search)
    {
        _search = search;
        _currentPage = 0;
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadProcessDefinitions()
    {
        try
        {
            _isLoading = true;
            _error = null;
            StateHasChanged();

            var definitions = await RepositoryService.GetProcessDefinitionsAsync(TenantContext.CurrentTenantId);
            _processDefinitions = definitions.ToList();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _processDefinitions.Clear();
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task RefreshData()
    {
        await LoadProcessDefinitions();
        Snackbar.Add("Process definitions refreshed", Severity.Success);
    }

    private async Task ViewDefinition(ProcessDefinition definition)
    {
        try
        {
            var xml = await RepositoryService.GetProcessDefinitionXmlAsync(definition.Id.ToString(), TenantContext.CurrentTenantId);
            
            var parameters = new DialogParameters
            {
                ["BpmnXml"] = xml,
                ["Title"] = $"Process Definition: {definition.Name}"
            };

            var options = new DialogOptions
            {
                MaxWidth = MaxWidth.ExtraExtraLarge,
                FullWidth = true
            };

            await DialogService.ShowAsync<BpmnViewerDialog>("BPMN Viewer", parameters, options);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading BPMN: {ex.Message}", Severity.Error);
        }
    }

    private async Task StartProcess(ProcessDefinition definition)
    {
        var parameters = new DialogParameters
        {
            ["ProcessDefinition"] = definition
        };

        var dialog = await DialogService.ShowAsync<StartProcessDialog>(
            $"Start Process: {definition.Name}", parameters);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            Snackbar.Add($"Process instance started for {definition.Name}", Severity.Success);
        }
    }

    private async Task ViewVersions(string processKey)
    {
        try
        {
            var versions = await RepositoryService.GetProcessDefinitionVersionsAsync(processKey, TenantContext.CurrentTenantId);
            
            var parameters = new DialogParameters
            {
                ["ProcessKey"] = processKey,
                ["Versions"] = versions.ToList()
            };

            await DialogService.ShowAsync<ProcessVersionsDialog>(
                $"Versions: {processKey}", parameters);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading versions: {ex.Message}", Severity.Error);
        }
    }

    private async Task DeleteDefinition(ProcessDefinition definition)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Delete process definition",
            $"Delete '{definition.Name}' version {definition.Version}? This removes the persisted definition.",
            yesText: "Delete",
            cancelText: "Cancel");
        if (confirmed != true)
            return;

        try
        {
            await RepositoryService.DeleteProcessDefinitionAsync(definition.Id, TenantContext.CurrentTenantId);
            _processDefinitions.Remove(definition);
            Snackbar.Add($"Process definition '{definition.Name}' deleted.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error deleting process definition: {ex.Message}", Severity.Error);
        }
    }
}
