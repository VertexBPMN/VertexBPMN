@page "/performance"
@using System.Text.Json
@inject IPerformanceService PerformanceService

<PageTitle>Performance</PageTitle>

<StudioPageHeader Title="Performance" Eyebrow="Analyze" Description="Read-only runtime performance data from the distributed engine API.">
    <Actions><MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh" OnClick="RefreshAsync" Disabled="_isLoading">Refresh</MudButton></Actions>
</StudioPageHeader>

@if (_error is not null)
{
    <StudioStatePanel Title="Performance data could not be loaded" Description="@_error" Icon="@Icons.Material.Outlined.ErrorOutline" />
}
else if (_dashboard is not null)
{
    <MudGrid>
        <MudItem xs="12" md="6">
            <MudPaper Class="studio-content-card" Elevation="0">
                <MudText Typo="Typo.h6">Dashboard</MudText>
                <pre class="studio-json-result">@Format(_dashboard.Value)</pre>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="6">
            <MudPaper Class="studio-content-card" Elevation="0">
                <MudText Typo="Typo.h6">Load Balancer</MudText>
                @if (_loadBalancer is not null)
                {
                    <pre class="studio-json-result">@Format(_loadBalancer.Value)</pre>
                }
            </MudPaper>
        </MudItem>
        <MudItem xs="12">
            <MudPaper Class="studio-content-card" Elevation="0">
                <MudText Typo="Typo.h6">Trends (24 hours)</MudText>
                @if (_trends is not null)
                {
                    <pre class="studio-json-result">@Format(_trends.Value)</pre>
                }
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@code {
    private JsonElement? _dashboard;
    private JsonElement? _loadBalancer;
    private JsonElement? _trends;
    private bool _isLoading;
    private string? _error;

    protected override Task OnInitializedAsync() => RefreshAsync();

    private async Task RefreshAsync()
    {
        _isLoading = true;
        _error = null;
        try
        {
            _dashboard = await PerformanceService.GetDashboardAsync();
            _loadBalancer = await PerformanceService.GetLoadBalancerStatusAsync();
            _trends = await PerformanceService.GetTrendsAsync();
        }
        catch (Exception exception)
        {
            _error = $"Performance data could not be loaded: {exception.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private static string Format(JsonElement value) =>
        JsonSerializer.Serialize(value, new JsonSerializerOptions { WriteIndented = true });
}
