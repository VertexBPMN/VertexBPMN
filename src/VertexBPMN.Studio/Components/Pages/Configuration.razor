@page "/configuration"
@inject VertexBPMN.Studio.Services.IEngineCapabilitiesService CapabilitiesService

<PageTitle>Configuration</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Configuration</MudText>

<MudAlert Severity="Severity.Info" Class="mb-4">
    Runtime configuration is read-only in Studio until the API exposes a configuration management contract.
</MudAlert>

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
}

<MudPaper Class="pa-4">
    <MudText Typo="Typo.h6">Engine capabilities</MudText>
    @if (_capabilities is null)
    {
        <MudProgressCircular Indeterminate="true" />
    }
    else
    {
        <MudList T="string">
            <MudListItem T="string">Engine: @_capabilities.EngineType</MudListItem>
            <MudListItem T="string">CMMN: @(_capabilities.SupportsCmmn ? "supported" : "not supported")</MudListItem>
            <MudListItem T="string">Workers: @(_capabilities.SupportsWorkers ? "supported" : "not supported")</MudListItem>
            <MudListItem T="string">Durable persistence: @(_capabilities.SupportsDurablePersistence ? "supported" : "not supported")</MudListItem>
        </MudList>
    }
</MudPaper>

@code {
    private VertexBPMN.Studio.Services.EngineCapabilities? _capabilities;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _capabilities = await CapabilitiesService.GetAsync();
        }
        catch (Exception exception)
        {
            _error = $"Engine capabilities could not be loaded: {exception.Message}";
        }
    }
}
