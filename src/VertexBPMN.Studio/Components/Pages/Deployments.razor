@page "/deployments"
@inject VertexBPMN.Studio.Services.IRepositoryService RepositoryService
@inject MudBlazor.ISnackbar Snackbar
@inject VertexBPMN.Studio.Services.ActiveEngineService ActiveEngineService
@inject VertexBPMN.Studio.Services.StudioTenantContext TenantContext
@inject ILogger<Deployments> Logger
@using System.Xml.Linq
@implements IDisposable

<PageTitle>Deployments</PageTitle>

<InputFile id="fileUpload"
           OnChange="UploadFiles"
           accept=".bpmn,.xml,application/xml,text/xml"
           multiple
           data-testid="deployment-upload"
           hidden />
<StudioPageHeader Title="Deployments"
                  Eyebrow="Work"
                  Description="Validate and deploy up to ten BPMN files to the active tenant.">
    <Actions>
        <MudButton HtmlTag="label"
                   Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.CloudUpload"
                   Disabled="_isLoading"
                   for="fileUpload">
            Upload BPMN files
        </MudButton>
    </Actions>
</StudioPageHeader>

@if (_isLoading)
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-4">
        <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="me-2" />
        Validating and deploying selected files…
    </MudAlert>
}

<MudPaper Class="studio-data-card" Elevation="0">
<MudTable Items="@_deployments" Hover="true" Dense="true" Breakpoint="Breakpoint.Sm" Class="studio-data-table" data-testid="deployments-table">
    <HeaderContent>
        <MudTh>Id</MudTh>
        <MudTh>Name</MudTh>
        <MudTh>Deployment Time</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Id"><MudText Typo="Typo.caption" Class="studio-technical-id">@context.Id</MudText></MudTd>
        <MudTd DataLabel="Name"><MudText Typo="Typo.body1" Class="studio-primary-cell">@context.Name</MudText></MudTd>
        <MudTd DataLabel="Deployment Time">@context.DeploymentTime</MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <StudioStatePanel Title="No deployments yet"
                          Description="Upload one or more BPMN files to create the first deployment."
                          Icon="@Icons.Material.Outlined.CloudUpload" />
    </NoRecordsContent>
</MudTable>
</MudPaper>

@code {
    private IEnumerable<VertexBPMN.Studio.Services.Deployment> _deployments = new List<VertexBPMN.Studio.Services.Deployment>();
    private const long MaximumUploadSize = 10 * 1024 * 1024;
    private const int MaximumFileCount = 10;
    private bool _isLoading = false;

    protected override async Task OnInitializedAsync()
    {
        ActiveEngineService.OnChange += StateHasChanged;
        TenantContext.Changed += OnTenantChanged;
        await LoadDeployments();
    }

    public void Dispose()
    {
        ActiveEngineService.OnChange -= StateHasChanged;
        TenantContext.Changed -= OnTenantChanged;
    }

    private async Task LoadDeployments()
    {
        _deployments = await RepositoryService.GetDeploymentsAsync(TenantContext.CurrentTenantId);
    }

    private async void OnTenantChanged()
    {
        await LoadDeployments();
        await InvokeAsync(StateHasChanged);
    }

    private async Task UploadFiles(InputFileChangeEventArgs args)
    {
        IReadOnlyList<IBrowserFile> files;
        try
        {
            files = args.GetMultipleFiles(MaximumFileCount);
        }
        catch (InvalidOperationException)
        {
            Snackbar.Add($"Select no more than {MaximumFileCount} BPMN files.", Severity.Error);
            return;
        }

        _isLoading = true;
        StateHasChanged();
        var deployedCount = 0;

        try
        {
            foreach (var file in files)
            {
                if (file.Size > MaximumUploadSize)
                {
                    Snackbar.Add($"{file.Name} exceeds the 10 MB upload limit.", Severity.Error);
                    continue;
                }

                if (!await IsValidBpmnAsync(file))
                {
                    Snackbar.Add($"{file.Name} is not valid BPMN XML.", Severity.Error);
                    continue;
                }

                try
                {
                    await RepositoryService.DeployAsync(file, TenantContext.CurrentTenantId);
                    deployedCount++;
                    if (files.Count == 1)
                        Snackbar.Add($"File {file.Name} deployed successfully!", Severity.Success);
                }
                catch (Exception exception)
                {
                    Logger.LogError(exception, "Failed to deploy BPMN file {FileName}", file.Name);
                    Snackbar.Add($"Error deploying file {file.Name}: {exception.Message}", Severity.Error);
                }
            }

            if (files.Count > 1 && deployedCount > 0)
                Snackbar.Add($"{deployedCount} BPMN files deployed successfully!", Severity.Success);
        }
        finally
        {
            _isLoading = false;
            await LoadDeployments();
            StateHasChanged();
        }
    }

    private static async Task<bool> IsValidBpmnAsync(IBrowserFile file)
    {
        try
        {
            await using var stream = file.OpenReadStream(MaximumUploadSize);
            var document = await XDocument.LoadAsync(stream, LoadOptions.None, CancellationToken.None);
            return document.Root?.Name.LocalName == "definitions"
                && document.Descendants().Any(element => element.Name.LocalName == "process");
        }
        catch (Exception exception) when (exception is System.Xml.XmlException or InvalidDataException or IOException)
        {
            return false;
        }
    }
}
