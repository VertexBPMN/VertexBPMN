    "Swagger": true,
    "Emails": false
  },
  "Notifications": {
    "Email": {
      "Enabled": false,
      "From": "noreply@example.com",
      "SmtpHost": "smtp.example.com",
      "Port": 587,
      "UseSsl": true,
      "Username": "smtp-user",
      "Password": "secret",
      "DefaultRecipients": [ "ops@example.com", "audit@example.com" ]
