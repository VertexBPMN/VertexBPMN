@page "/triggers"
@implements IDisposable
@inject IWorkflowTriggerService TriggerService
@inject StudioTenantContext TenantContext
@inject NavigationManager Navigation

<PageTitle>Workflow Triggers</PageTitle>

<StudioPageHeader Title="Workflow Triggers" Eyebrow="Operate" Description="Register secure external endpoints for starting deployed BPMN processes." />

@if (string.IsNullOrWhiteSpace(TenantContext.CurrentTenantId))
{
    <StudioStatePanel Title="Select a tenant" Description="Choose a tenant before managing workflow triggers." Icon="@Icons.Material.Outlined.Apartment" />
}
else
{
    <MudPaper Class="studio-content-card mb-4" Elevation="0">
        <MudText Typo="Typo.h6">Register trigger</MudText>
        <MudGrid>
            <MudItem xs="12" sm="6"><MudTextField @bind-Value="_name" Label="Name" Variant="Variant.Outlined" /></MudItem>
            <MudItem xs="12" sm="6"><MudTextField @bind-Value="_processDefinitionKey" Label="Process definition key" Variant="Variant.Outlined" /></MudItem>
        </MudGrid>
        <MudButton Class="mt-3" Variant="Variant.Filled" Color="Color.Primary" OnClick="CreateAsync" Disabled="@_busy">Register trigger</MudButton>
    </MudPaper>

    @if (!string.IsNullOrWhiteSpace(_newSecret))
    {
        <MudAlert Severity="Severity.Warning" Class="mb-4">
            <MudText Typo="Typo.subtitle2">Save this secret now. It is shown only once.</MudText>
            <MudTextField @bind-Value="_newSecret" ReadOnly="true" Variant="Variant.Outlined" />
            <MudText Typo="Typo.caption">Invoke path: @_invokePath</MudText>
        </MudAlert>
    }

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <StudioStatePanel Title="Trigger operation failed" Description="@_error" Icon="@Icons.Material.Outlined.ErrorOutline" />
    }

    <MudPaper Class="studio-data-card" Elevation="0">
        <div class="studio-data-card__heading"><MudText Typo="Typo.h6">Registered triggers</MudText></div>
        <MudTable Items="_triggers" Dense="true" Hover="true" Breakpoint="Breakpoint.Md" Class="studio-data-table">
            <HeaderContent>
                <MudTh>Name</MudTh>
                <MudTh>Process key</MudTh>
                <MudTh>Webhook endpoint</MudTh>
                <MudTh>Status</MudTh>
                <MudTh>Invocations</MudTh>
                <MudTh>Actions</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Name">@context.Name</MudTd>
                <MudTd DataLabel="Process key">@context.ProcessDefinitionKey</MudTd>
                <MudTd DataLabel="Webhook endpoint">
                    @if (!string.IsNullOrWhiteSpace(context.Path))
                    {
                        <MudText Typo="Typo.caption">@context.Method @BuildWebhookUrl(context)</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@BuildCurlExample(context)</MudText>
                    }
                    else
                    {
                        <MudText Typo="Typo.caption">Legacy trigger API</MudText>
                    }
                </MudTd>
                <MudTd DataLabel="Status">@(context.Enabled ? "Enabled" : "Disabled")</MudTd>
                <MudTd DataLabel="Invocations">@context.InvocationCount</MudTd>
                <MudTd DataLabel="Actions">
                    <MudButton Size="Size.Small" Color="@(context.Enabled ? Color.Warning : Color.Success)" OnClick="@(() => SetEnabledAsync(context))">
                        @(context.Enabled ? "Disable" : "Enable")
                    </MudButton>
                    <MudButton Size="Size.Small" Color="Color.Primary" OnClick="@(() => InvokeAsync(context))" Disabled="@string.IsNullOrWhiteSpace(_newSecret)">Test</MudButton>
                    <MudButton Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteAsync(context))">Delete</MudButton>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent><StudioStatePanel Title="No triggers registered" Description="Register a trigger to expose a secure process-start endpoint." Icon="@Icons.Material.Outlined.Bolt" /></NoRecordsContent>
        </MudTable>
    </MudPaper>
}

@code {
    private IReadOnlyList<StudioWorkflowTrigger> _triggers = [];
    private string _name = string.Empty;
    private string _processDefinitionKey = string.Empty;
    private string _newSecret = string.Empty;
    private string _invokePath = string.Empty;
    private string? _error;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        TenantContext.Changed += OnTenantChanged;
        await LoadAsync();
    }

    private async void OnTenantChanged()
    {
        await InvokeAsync(async () =>
        {
            await LoadAsync();
            StateHasChanged();
        });
    }

    private async Task LoadAsync()
    {
        _error = null;
        var tenantId = TenantContext.CurrentTenantId;
        if (string.IsNullOrWhiteSpace(tenantId))
        {
            _triggers = [];
            return;
        }
        try
        {
            _triggers = await TriggerService.ListAsync(tenantId);
        }
        catch (Exception exception)
        {
            _error = exception.Message;
        }
    }

    private async Task CreateAsync()
    {
        var tenantId = TenantContext.CurrentTenantId;
        if (string.IsNullOrWhiteSpace(tenantId)) return;
        _busy = true;
        _error = null;
        try
        {
            var created = await TriggerService.CreateAsync(tenantId, _name, _processDefinitionKey);
            _newSecret = created.Secret;
            _invokePath = created.InvokePath;
            _name = _processDefinitionKey = string.Empty;
            await LoadAsync();
        }
        catch (Exception exception)
        {
            _error = exception.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private Task SetEnabledAsync(StudioWorkflowTrigger trigger) => MutateAsync(() =>
        TriggerService.UpdateAsync(trigger.TenantId ?? TenantContext.CurrentTenantId!, trigger.Id, null, !trigger.Enabled));

    private Task DeleteAsync(StudioWorkflowTrigger trigger) => MutateAsync(() =>
        TriggerService.DeleteAsync(trigger.TenantId ?? TenantContext.CurrentTenantId!, trigger.Id));

    private async Task InvokeAsync(StudioWorkflowTrigger trigger)
    {
        _busy = true;
        _error = null;
        try
        {
            await TriggerService.InvokeAsync(trigger.Id, _newSecret, businessKey: $"studio-{DateTime.UtcNow:yyyyMMddHHmmss}");
            await LoadAsync();
        }
        catch (Exception exception)
        {
            _error = exception.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task MutateAsync(Func<Task> mutation)
    {
        _busy = true;
        _error = null;
        try
        {
            await mutation();
            await LoadAsync();
        }
        catch (Exception exception)
        {
            _error = exception.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private string BuildWebhookUrl(StudioWorkflowTrigger trigger) =>
        $"{Navigation.BaseUri.TrimEnd('/')}/api/webhooks{trigger.Path}";

    private string BuildCurlExample(StudioWorkflowTrigger trigger)
    {
        var auth = string.Equals(trigger.AuthenticationMode, "hmac-sha256", StringComparison.OrdinalIgnoreCase)
            ? "-H 'X-VertexBPMN-Signature: sha256=<hmac>'"
            : "-H 'X-VertexBPMN-Trigger-Secret: <secret>'";
        return $"curl -X {trigger.Method ?? "POST"} '{BuildWebhookUrl(trigger)}' {auth} -H 'Content-Type: application/json' -d '{{}}'";
    }

    public void Dispose() => TenantContext.Changed -= OnTenantChanged;
}
