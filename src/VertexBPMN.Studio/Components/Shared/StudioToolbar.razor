<div class="studio-toolbar @Class" role="toolbar" aria-label="@AriaLabel">
    @ChildContent
</div>

@code {
    [Parameter, EditorRequired] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string AriaLabel { get; set; } = "Page actions";
    [Parameter] public string? Class { get; set; }
}
