@page "/health"
@using System.Text.Json
@inject IHealthService HealthService

<PageTitle>Health and Operations</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Health and Operations</MudText>

<MudStack Row="true" Spacing="2" Class="mb-4">
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="RefreshAsync" Disabled="_isLoading">
        Refresh
    </MudButton>
</MudStack>

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
}

<MudGrid>
    <MudItem xs="12" md="6">
        <MudPaper Class="pa-4">
            <MudText Typo="Typo.h6">Comprehensive health</MudText>
            @RenderPayload(_comprehensiveHealth)
        </MudPaper>
    </MudItem>
    <MudItem xs="12" md="6">
        <MudPaper Class="pa-4">
            <MudText Typo="Typo.h6">System metrics</MudText>
            @RenderPayload(_systemMetrics)
        </MudPaper>
    </MudItem>
    <MudItem xs="12">
        <MudPaper Class="pa-4">
            <MudText Typo="Typo.h6">Circuit breakers</MudText>
            @RenderPayload(_circuitBreakers)
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private JsonElement? _comprehensiveHealth;
    private JsonElement? _systemMetrics;
    private JsonElement? _circuitBreakers;
    private bool _isLoading;
    private string? _error;

    protected override Task OnInitializedAsync() => RefreshAsync();

    private async Task RefreshAsync()
    {
        _isLoading = true;
        _error = null;

        try
        {
            var comprehensiveHealth = HealthService.GetComprehensiveHealthAsync();
            var systemMetrics = HealthService.GetSystemMetricsAsync();
            var circuitBreakers = HealthService.GetCircuitBreakersAsync();
            await Task.WhenAll(comprehensiveHealth, systemMetrics, circuitBreakers);

            _comprehensiveHealth = await comprehensiveHealth;
            _systemMetrics = await systemMetrics;
            _circuitBreakers = await circuitBreakers;
        }
        catch (Exception exception)
        {
            _error = $"Health data could not be loaded: {exception.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private static RenderFragment RenderPayload(JsonElement? payload) => builder =>
    {
        if (payload is null)
        {
            builder.AddContent(0, "No data available.");
            return;
        }

        builder.OpenElement(1, "pre");
        builder.AddAttribute(2, "class", "mt-3");
        builder.AddContent(3, JsonSerializer.Serialize(payload.Value, new JsonSerializerOptions { WriteIndented = true }));
        builder.CloseElement();
    };
}
