# ---------------------------------------------------------------------------
# VertexBPMN full-stack secrets — copy to `.env` and fill every value.
# None of these should be committed; `.env` is intentionally gitignored.
# ---------------------------------------------------------------------------

# --- engine Postgres (5 databases: vertexbpmn_bpmn/tenants/simulation/events/decision) ---
POSTGRES_USER=vertexbpmn
POSTGRES_PASSWORD=change-me-engine-db-password

# --- RabbitMQ (AMQP + management UI on :15672) ---
RABBITMQ_USER=vertexbpmn
RABBITMQ_PASSWORD=change-me-rabbitmq-password

# --- Keycloak admin + its own Postgres ---
KEYCLOAK_ADMIN_USER=vertexbpmn-admin
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak-admin
KEYCLOAK_DB_PASSWORD=change-me-keycloak-db

# --- OIDC ---
# Studio is a confidential client; this secret is set in Keycloak by the
# keycloak-bootstrap one-shot and must match StudioAuthentication__ClientSecret.
KEYCLOAK_STUDIO_CLIENT_SECRET=change-me-studio-client-secret
# Demo browser/login user created by the bootstrap:
KEYCLOAK_TEST_USER=vertexbpmn-user
KEYCLOAK_TEST_USER_PASSWORD=change-me-test-user
KEYCLOAK_TEST_USER_TENANT=tenant-a
KEYCLOAK_TEST_USER_ROLE=ProcessManager

# Public URL of Keycloak as seen by the BROWSER (must match the redirect URI
# in deploy/keycloak/vertexbpmn-realm.json and the app loopback authority).
KEYCLOAK_PUBLIC_URL=http://localhost:58080
