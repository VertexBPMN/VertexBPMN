<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net9.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsPackable>true</IsPackable>
		<Version>1.0.0</Version>
		<Description>BPMN2.0 Metamodel for .NET9</Description>
		<AssemblyName>VertexBPMN.Model.Domain.Model.Schema</AssemblyName>
		<RootNamespace>VertexBPMN.Domain.Model</RootNamespace>
		<EnableMicrosoftTestingPlatform>true</EnableMicrosoftTestingPlatform>
		<TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
		<TestingPlatformShowTestsFailure>true</TestingPlatformShowTestsFailure>
		<!--Disable caching to prevent infinite regeneration--><!-- 
		<SourceGeneratorsCacheEnabled>false</SourceGeneratorsCacheEnabled>
		--><!--View generated code in obj/Generated/ for debugging without compiling them twice--><!-- 
		<EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
		<CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)Generated</CompilerGeneratedFilesOutputPath>
		<CompileSourcesExcludingGeneratedFiles>false</CompileSourcesExcludingGeneratedFiles>
		--><!-- Temporarily disable entity generator analyzer to stop buggy code generation --><!--
		<EnableEntityGenerator>false</EnableEntityGenerator>-->
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="MartinCostello.Logging.XUnit.v3" Version="0.6.0" />
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.10" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="9.0.10" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="9.0.10" />
		<!--<PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.9" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.9" />
		<PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.4" />-->
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.10">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
		<PackageReference Include="xunit.v3" Version="3.0.1" />
		<PackageReference Include="Microsoft.Testing.Platform" Version="1.8.4" />
		<PackageReference Include="Microsoft.Testing.Platform.MSBuild" Version="1.8.4" />
		<PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="17.14.2" />
		<PackageReference Include="BenchmarkDotNet" Version="0.15.4" />
		<PackageReference Include="coverlet.collector" Version="6.0.4">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Grpc.Net.Client" Version="2.71.0" />
		<PackageReference Include="Moq" Version="4.20.72" />
		<PackageReference Include="Shouldly" Version="4.3.0" />
		<PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="9.0.9" />
	</ItemGroup>
	<ItemGroup>
		<Content Include="..\..\tests\VertexBPMN.Tests\TestData\**\*.*">
			<Link>TestData\%(RecursiveDir)%(Filename)%(Extension)</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>
	<ItemGroup>
		<None Update="Schemas\BPMN20\BPMN20-FromXMI.xslt">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="Schemas\BPMN20\BPMN20.xsd">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="Schemas\BPMN20\BPMNDI.xsd">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="Schemas\BPMN20\DC.xsd">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="Schemas\BPMN20\DI.xsd">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="Schemas\BPMN20\Semantic.xsd">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>
	<ItemGroup>
	 <Folder Include="Bpmn\Dto\" />
	 <Folder Include="Bpmn\Dto\" />
	 <Folder Include="Dto\" />
	 <Folder Include="Schemas\BPMN20\Generated\" />
	 <Folder Include="Schemas\CMMN11\Generated\" />
	 <Folder Include="Schemas\DMN12\Generated\" />
	</ItemGroup>
	<!-- Analyzer reference disabled while fixing generator duplication --><!--
	<ItemGroup Condition="'$(EnableEntityGenerator)' == 'true'">
		<ProjectReference Include="..\..\utils\VertexBPMN.EntityGenerator\VertexBPMN.EntityGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
	</ItemGroup>-->
</Project>