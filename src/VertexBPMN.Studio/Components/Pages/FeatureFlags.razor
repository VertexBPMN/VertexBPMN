@page "/feature-flags"
@using Microsoft.AspNetCore.Components.Authorization
@using System.Text.Json
@inject IFeatureFlagService FeatureFlagService

<PageTitle>Feature Flags</PageTitle>

<StudioPageHeader Title="Feature Flags" Eyebrow="Manage" Description="Inspect runtime feature state and change flags when authorized.">
    <Actions><MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh" OnClick="RefreshAsync" Disabled="_isLoading">Refresh</MudButton></Actions>
</StudioPageHeader>

@if (_error is not null)
{
    <StudioStatePanel Title="Feature flags could not be loaded" Description="@_error" Icon="@Icons.Material.Outlined.ErrorOutline" />
}
else if (_flags is not null)
{
    <MudPaper Class="studio-data-card" Elevation="0"><MudTable Items="_flags.Value.EnumerateObject()" Hover="true" Dense="true" Breakpoint="Breakpoint.Sm" Class="studio-data-table">
        <HeaderContent>
            <MudTh>Flag</MudTh>
            <MudTh>Enabled</MudTh>
            <MudTh>Admin action</MudTh>
        </HeaderContent>
        <RowTemplate Context="flag">
            <MudTd DataLabel="Flag">@flag.Name</MudTd>
            <MudTd DataLabel="Enabled">
                <MudChip T="string" Color="@(flag.Value.GetBoolean() ? Color.Success : Color.Default)">
                    @(flag.Value.GetBoolean() ? "Enabled" : "Disabled")
                </MudChip>
            </MudTd>
            <MudTd DataLabel="Admin action">
                <AuthorizeView Roles="Admin">
                    <Authorized>
                        <MudSwitch T="bool"
                                   Value="@flag.Value.GetBoolean()"
                                   ValueChanged="value => SetFlagAsync(flag.Name, value)"
                                   Color="Color.Primary"
                                   Disabled="_isLoading" />
                    </Authorized>
                    <NotAuthorized>
                        <MudText Typo="Typo.caption" Color="Color.Tertiary">Admin only</MudText>
                    </NotAuthorized>
                </AuthorizeView>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent><StudioStatePanel Title="No feature flags found" Description="The active API did not report runtime feature flags." Icon="@Icons.Material.Outlined.Flag" /></NoRecordsContent>
    </MudTable></MudPaper>
}

@code {
    private JsonElement? _flags;
    private bool _isLoading;
    private string? _error;

    protected override Task OnInitializedAsync() => RefreshAsync();

    private async Task RefreshAsync()
    {
        _isLoading = true;
        _error = null;
        try
        {
            _flags = await FeatureFlagService.GetAllAsync();
        }
        catch (Exception exception)
        {
            _error = $"Feature flags could not be loaded: {exception.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task SetFlagAsync(string name, bool enabled)
    {
        _isLoading = true;
        _error = null;
        try
        {
            await FeatureFlagService.SetAsync(name, enabled);
            _flags = await FeatureFlagService.GetAllAsync();
        }
        catch (Exception exception)
        {
            _error = $"Feature flag could not be updated: {exception.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }
}
