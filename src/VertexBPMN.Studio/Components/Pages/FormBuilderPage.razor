@page "/form-builder"
@using System.Text
@inject MudBlazor.ISnackbar Snackbar
@inject IHttpClientFactory HttpClientFactory
@inject IJSRuntime JSRuntime
@inject IFormDefinitionService FormService
@inject StudioTenantContext TenantContext

<PageTitle>Form Builder</PageTitle>

<MudStack Spacing="3">
    <div>
        <MudText Typo="Typo.h4" GutterBottom="true">Form Builder</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            form-js Builder fuer User-Task-Formulare mit Runtime Viewer fuer Vorschau und Ausfuehrung.
        </MudText>
    </div>

    <MudPaper Class="pa-4">
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
            <MudTextField Label="Form key" @bind-Value="_formKey" Required="true" />
            <MudTextField Label="Form name" @bind-Value="_formName" Required="true" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveFormJson" StartIcon="@Icons.Material.Filled.Save">Save form</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="ExportFormJson" StartIcon="@Icons.Material.Filled.Download">Export JSON</MudButton>
            <MudButton Variant="Variant.Outlined" OnClick="@(() => LoadFormJson())" StartIcon="@Icons.Material.Filled.Refresh">Load JSON</MudButton>
            <MudChip T="string" Color="Color.Info" Variant="Variant.Outlined">Tenant: @(TenantContext.CurrentTenantId ?? "select tenant")</MudChip>
        </MudStack>
    </MudPaper>

    <MudPaper Class="pa-4">
        <MudText Typo="Typo.h6" GutterBottom="true">Builder</MudText>
        <FormBuilderSurface @ref="_builder" Json="_formJson" />
    </MudPaper>

    <MudPaper Class="pa-4">
        <MudText Typo="Typo.h6" GutterBottom="true">Runtime Viewer</MudText>
        <FormViewerSurface Json="_savedFormJson" />
    </MudPaper>
</MudStack>

@code {
    private string _formJson = FallbackFormJson;
    private string _savedFormJson = FallbackFormJson;
    private HttpClient _httpClient = default!;
    private FormBuilderSurface? _builder;
    private string _formKey = "invoice-approval";
    private string _formName = "Invoice approval";
    private string? _formId;

    private const string FallbackFormJson = """
{
  "type": "default",
  "components": [
    {
      "key": "invoiceNumber",
      "label": "Invoice number",
      "type": "textfield"
    }
  ]
}
""";

    protected override async Task OnInitializedAsync()
    {
        _httpClient = HttpClientFactory.CreateClient("Default");
        await LoadFormJson(showNotification: false);
    }

    private async Task SaveFormJson()
    {
        _formJson = await CaptureFormJson();
        _savedFormJson = _formJson;
        if (string.IsNullOrWhiteSpace(TenantContext.CurrentTenantId)) { Snackbar.Add("Select a tenant before saving the form.", Severity.Warning); return; }
        var request = new StudioFormWriteRequest(TenantContext.CurrentTenantId, _formKey, _formName, _formJson);
        if (_formId is null) _formId = (await FormService.CreateAsync(request)).Id; else await FormService.UpdateAsync(_formId, request);
        Snackbar.Add("Form saved in the registry and refreshed in the Runtime Viewer.", Severity.Success);
    }

    private async Task ExportFormJson()
    {
        _formJson = await CaptureFormJson();
        await DownloadTextAsync("studio-form.form.json", _formJson, "application/json");
        Snackbar.Add("Form JSON exported.", Severity.Success);
    }

    private async Task LoadFormJson(bool showNotification = true)
    {
        try
        {
            _formJson = await _httpClient.GetStringAsync("data/invoiceApprovalForm.json");
            _savedFormJson = _formJson;
            if (showNotification)
                Snackbar.Add("Form JSON loaded.", Severity.Info);
        }
        catch (Exception ex)
        {
            _formJson = FallbackFormJson;
            _savedFormJson = _formJson;
            if (showNotification)
                Snackbar.Add($"Form template not found. Using fallback. ({ex.Message})", Severity.Warning);
        }
    }

    private async Task<string> CaptureFormJson()
    {
        if (_builder is not null)
            _formJson = await _builder.GetJsonAsync();
        return _formJson;
    }

    private async Task DownloadTextAsync(string fileName, string content, string contentType)
    {
        var dataUri = $"data:{contentType};base64,{Convert.ToBase64String(Encoding.UTF8.GetBytes(content))}";
        await JSRuntime.InvokeVoidAsync("downloadFile", fileName, dataUri);
    }
}
