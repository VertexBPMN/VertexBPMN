@inject IEngineCapabilitiesService CapabilitiesService

<MudNavMenu>
    <NavSectionLabel Text="Overview" />
    <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.SpaceDashboard">Dashboard</MudNavLink>

    <NavSectionLabel Text="Model" />
    <MudNavLink Href="/bpmn-modeler" Icon="@Icons.Material.Outlined.AccountTree">BPMN Modeler</MudNavLink>
    <MudNavLink Href="/dmn-modeler" Icon="@Icons.Material.Outlined.Rule">DMN Modeler</MudNavLink>
    @if (_capabilities?.SupportsCmmn == true)
    {
        <MudNavLink Href="/cmmn-modeler" Icon="@Icons.Material.Outlined.Schema">CMMN Modeler</MudNavLink>
    }
    <MudNavLink Href="/form-builder" Icon="@Icons.Material.Outlined.DynamicForm">Form Builder</MudNavLink>
    <MudNavLink Href="/process-definitions" Icon="@Icons.Material.Outlined.Description">Process Definitions</MudNavLink>

    <NavSectionLabel Text="Operate" />
    <MudNavLink Href="/tasks" Icon="@Icons.Material.Outlined.TaskAlt">Tasks</MudNavLink>
    <MudNavLink Href="/process-instances" Icon="@Icons.Material.Outlined.PlayCircle">Process Instances</MudNavLink>
    <MudNavLink Href="/deployments" Icon="@Icons.Material.Outlined.CloudUpload">Deployments</MudNavLink>
    <MudNavLink Href="/triggers" Icon="@Icons.Material.Outlined.Bolt">Workflow Triggers</MudNavLink>
    <MudNavLink Href="/messages-signals" Icon="@Icons.Material.Outlined.Campaign">Messages &amp; Signals</MudNavLink>

    <NavSectionLabel Text="Analyze" />
    <MudNavLink Href="/history" Icon="@Icons.Material.Outlined.History">History</MudNavLink>
    <MudNavLink Href="/execution-details" Icon="@Icons.Material.Outlined.FactCheck">Execution Details</MudNavLink>
    <MudNavLink Href="/event-log" Icon="@Icons.Material.Outlined.ReceiptLong">Event Log</MudNavLink>
    <MudNavLink Href="/analytics" Icon="@Icons.Material.Outlined.Analytics">Analytics</MudNavLink>
    <MudNavLink Href="/performance" Icon="@Icons.Material.Outlined.Speed">Performance</MudNavLink>
    <MudNavLink Href="/health" Icon="@Icons.Material.Outlined.HealthAndSafety">Health</MudNavLink>
    <MudNavLink Href="/simulation" Icon="@Icons.Material.Outlined.Science">Simulation</MudNavLink>
    <MudNavLink Href="/debugging" Icon="@Icons.Material.Outlined.BugReport">Debugging</MudNavLink>
    <MudNavLink Href="/compliance" Icon="@Icons.Material.Outlined.VerifiedUser">Compliance</MudNavLink>

    <NavSectionLabel Text="Manage" />
    <MudNavLink Href="/engine-management" Icon="@Icons.Material.Outlined.Dns">Engine Management</MudNavLink>
    <MudNavLink Href="/tenants" Icon="@Icons.Material.Outlined.Groups">Tenants</MudNavLink>
    <MudNavLink Href="/credentials" Icon="@Icons.Material.Outlined.Key">Credentials</MudNavLink>
    <MudNavLink Href="/configuration" Icon="@Icons.Material.Outlined.Settings">Configuration</MudNavLink>
    <MudNavLink Href="/feature-flags" Icon="@Icons.Material.Outlined.Flag">Feature Flags</MudNavLink>
    <MudNavLink Href="/migration" Icon="@Icons.Material.Outlined.SwapHoriz">Migration</MudNavLink>
    <MudNavLink Href="/connectors" Icon="@Icons.Material.Outlined.Extension">Connectors</MudNavLink>
    <MudNavLink Href="/extensions" Icon="@Icons.Material.Outlined.Widgets">Extensions</MudNavLink>
    <MudNavLink Href="/sso" Icon="@Icons.Material.Outlined.AdminPanelSettings">Single Sign-On</MudNavLink>
</MudNavMenu>

@code {
    private EngineCapabilities? _capabilities;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _capabilities = await CapabilitiesService.GetAsync();
        }
        catch
        {
            _capabilities = null;
        }
    }
}
