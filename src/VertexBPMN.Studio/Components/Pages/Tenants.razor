@page "/tenants"
@inject IIdentityService IdentityService
@inject StudioTenantContext TenantContext

<PageTitle>Tenants</PageTitle>

<StudioPageHeader Title="Tenants" Eyebrow="Manage" Description="Manage tenants visible through the identity API.">
    <Actions><MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh" OnClick="RefreshAsync" Disabled="_isLoading">Refresh</MudButton></Actions>
</StudioPageHeader>
<AuthorizeView Roles="Admin">
    <MudPaper Class="studio-content-card mb-4" Elevation="0" data-testid="tenant-admin-create">
        <MudText Typo="Typo.h6" Class="mb-3">Create tenant</MudText>
        <MudTextField @bind-Value="_name" Label="Tenant name" Variant="Variant.Outlined" Class="mb-3" />
        <MudTextField @bind-Value="_description" Label="Description" Variant="Variant.Outlined" Class="mb-3" />
        <MudButton Variant="Variant.Outlined" Color="Color.Success" OnClick="CreateAsync" Disabled="_isLoading || string.IsNullOrWhiteSpace(_name)" Class="mb-4">
            Create tenant (Admin)
        </MudButton>
    </MudPaper>
</AuthorizeView>

@if (_editingId is not null)
{
    <AuthorizeView Roles="Admin">
        <MudPaper Class="studio-content-card mb-4" Elevation="0" data-testid="tenant-edit">
            <MudText Typo="Typo.h6">Edit tenant</MudText>
            <MudTextField @bind-Value="_editName" Label="Edit tenant name" Variant="Variant.Outlined" Class="mb-3" />
            <MudTextField @bind-Value="_editDescription" Label="Edit description" Variant="Variant.Outlined" Class="mb-3" />
            <MudButton Color="Color.Primary" OnClick="SaveEditAsync" Disabled="_isLoading || string.IsNullOrWhiteSpace(_editName)">Save tenant</MudButton>
            <MudButton OnClick="CancelEdit" Disabled="_isLoading">Cancel edit</MudButton>
        </MudPaper>
    </AuthorizeView>
}

@if (_error is not null)
{
    <StudioStatePanel Title="Tenant operation failed" Description="@_error" Icon="@Icons.Material.Outlined.ErrorOutline" />
}
else if (_tenants is not null)
{
    <MudPaper Class="studio-data-card" Elevation="0"><MudTable Items="_tenants" Hover="true" Dense="true" Breakpoint="Breakpoint.Md" Class="studio-data-table">
        <HeaderContent>
            <MudTh>Id</MudTh>
            <MudTh>Name</MudTh>
            <MudTh>Description</MudTh>
            <AuthorizeView Roles="Admin" Context="headerAuth"><MudTh>Actions</MudTh></AuthorizeView>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Id"><span class="studio-technical-id">@context.Id</span></MudTd>
            <MudTd DataLabel="Name">@context.Name</MudTd>
            <MudTd DataLabel="Description">@context.Description</MudTd>
            <AuthorizeView Roles="Admin" Context="rowAuth">
                <MudTd DataLabel="Actions" data-testid="tenant-admin-actions">
                    <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="() => BeginEdit(context)" Disabled="_isLoading">Update</MudButton>
                    <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="() => DeleteAsync(context.Id)" Disabled="_isLoading">Delete</MudButton>
                </MudTd>
            </AuthorizeView>
        </RowTemplate>
        <NoRecordsContent><StudioStatePanel Title="No tenants found" Description="Create a tenant to begin isolating process data." Icon="@Icons.Material.Outlined.Apartment" /></NoRecordsContent>
    </MudTable></MudPaper>
}

@code {
    private IReadOnlyList<StudioTenant>? _tenants;
    private bool _isLoading;
    private string? _error;
    private string _name = string.Empty;
    private string _description = string.Empty;
    private string? _editingId;
    private string _editName = string.Empty;
    private string? _editDescription;

    protected override Task OnInitializedAsync() => RefreshAsync();

    private async Task RefreshAsync()
    {
        _isLoading = true;
        _error = null;
        try
        {
            _tenants = await IdentityService.ListTenantsAsync();
        }
        catch (Exception exception)
        {
            _error = $"Tenants could not be loaded: {exception.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task CreateAsync()
    {
        await RunAdminOperationAsync(async () =>
        {
            await IdentityService.CreateTenantAsync(_name, _description);
            _name = string.Empty;
            _description = string.Empty;
            await RefreshAsync();
            TenantContext.NotifyTenantsChanged();
        });
    }

    private void BeginEdit(StudioTenant tenant)
    {
        _editingId = tenant.Id;
        _editName = tenant.Name;
        _editDescription = tenant.Description;
    }

    private void CancelEdit() => _editingId = null;

    private async Task SaveEditAsync()
    {
        if (_editingId is null || string.IsNullOrWhiteSpace(_editName)) return;
        await RunAdminOperationAsync(async () =>
        {
            await IdentityService.UpdateTenantAsync(_editingId, _editName.Trim(), _editDescription);
            CancelEdit();
            await RefreshAsync();
            TenantContext.NotifyTenantsChanged();
        });
    }

    private async Task DeleteAsync(string id)
    {
        await RunAdminOperationAsync(async () =>
        {
            await IdentityService.DeleteTenantAsync(id);
            await RefreshAsync();
            if (_editingId == id) CancelEdit();
            TenantContext.NotifyTenantsChanged();
        });
    }

    private async Task RunAdminOperationAsync(Func<Task> operation)
    {
        _isLoading = true;
        _error = null;
        try
        {
            await operation();
        }
        catch (Exception exception)
        {
            _error = $"Tenant operation failed: {exception.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }
}
