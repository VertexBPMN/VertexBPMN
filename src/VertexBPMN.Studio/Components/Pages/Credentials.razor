@page "/credentials"
@implements IDisposable
@using Microsoft.AspNetCore.Components.Authorization
@inject ICredentialService CredentialService
@inject StudioTenantContext TenantContext

<PageTitle>Credentials</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Credentials</MudText>
<MudText Typo="Typo.body2" Color="Color.Tertiary" Class="mb-4">
    Secret values are encrypted by the API and are never shown again after saving. Only metadata and secret-key names are displayed here.
</MudText>

<MudAlert Severity="Severity.Info" Class="mb-4">Select a tenant before managing credentials. User passwords remain managed by the external OIDC provider.</MudAlert>

@if (string.IsNullOrWhiteSpace(TenantContext.CurrentTenantId))
{
    <MudAlert Severity="Severity.Warning">No tenant selected.</MudAlert>
}
else
{
    <AuthorizeView Roles="Admin">
        <Authorized>
            <MudPaper Class="pa-4 mb-4">
                <MudText Typo="Typo.h6" GutterBottom="true">Add credential</MudText>
                <MudGrid>
                    <MudItem xs="12" sm="6"><MudTextField @bind-Value="_name" Label="Name" Variant="Variant.Outlined" /></MudItem>
                    <MudItem xs="12" sm="6"><MudTextField @bind-Value="_type" Label="Type" Variant="Variant.Outlined" /></MudItem>
                    <MudItem xs="12"><MudTextField @bind-Value="_description" Label="Description" Variant="Variant.Outlined" /></MudItem>
                    <MudItem xs="12" sm="4"><MudTextField @bind-Value="_key" Label="Secret key" Variant="Variant.Outlined" /></MudItem>
                    <MudItem xs="12" sm="8"><MudTextField @bind-Value="_value" Label="Secret value" InputType="InputType.Password" Variant="Variant.Outlined" /></MudItem>
                </MudGrid>
                <MudButton Class="mt-4" Variant="Variant.Filled" Color="Color.Primary" OnClick="CreateAsync" Disabled="_isLoading || !CanCreate">Create credential</MudButton>
            </MudPaper>
        </Authorized>
        <NotAuthorized><MudAlert Severity="Severity.Warning">Credential changes are restricted to administrators.</MudAlert></NotAuthorized>
    </AuthorizeView>

    @if (_error is not null) { <MudAlert Severity="Severity.Error">@_error</MudAlert> }
    @if (_credentials is not null)
    {
        <MudTable Items="_credentials" Hover="true" Striped="true">
            <HeaderContent><MudTh>Name</MudTh><MudTh>Type</MudTh><MudTh>Secret keys</MudTh><MudTh>Last modified</MudTh><MudTh>Actions</MudTh></HeaderContent>
            <RowTemplate Context="credential">
                <MudTd DataLabel="Name">@credential.Name</MudTd>
                <MudTd DataLabel="Type">@credential.Type</MudTd>
                <MudTd DataLabel="Secret keys">@string.Join(", ", credential.SecretKeys)</MudTd>
                <MudTd DataLabel="Last modified">@credential.LastModified.ToLocalTime()</MudTd>
                <MudTd DataLabel="Actions">
                    <AuthorizeView Roles="Admin">
                        <Authorized Context="authState">
                            <MudButton Variant="Variant.Text" Color="Color.Warning" OnClick="() => RotateAsync(credential)" Disabled="_isLoading">Rotate</MudButton>
                            <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="() => DeleteAsync(credential.Id)" Disabled="_isLoading">Delete</MudButton>
                        </Authorized>
                    </AuthorizeView>
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
}

@code {
    private IReadOnlyList<StudioCredential>? _credentials;
    private string _name = string.Empty;
    private string _type = "api-key";
    private string _description = string.Empty;
    private string _key = "value";
    private string _value = string.Empty;
    private bool _isLoading;
    private string? _error;
    private bool CanCreate => !string.IsNullOrWhiteSpace(_name) && !string.IsNullOrWhiteSpace(_type) && !string.IsNullOrWhiteSpace(_key) && !string.IsNullOrEmpty(_value);

    protected override async Task OnInitializedAsync()
    {
        TenantContext.Changed += OnTenantChanged;
        await RefreshAsync();
    }

    public void Dispose() => TenantContext.Changed -= OnTenantChanged;

    private async void OnTenantChanged() => await InvokeAsync(async () =>
    {
        await RefreshAsync();
        StateHasChanged();
    });

    private async Task RefreshAsync()
    {
        if (string.IsNullOrWhiteSpace(TenantContext.CurrentTenantId)) { _credentials = null; return; }
        _isLoading = true; _error = null;
        try { _credentials = await CredentialService.ListAsync(TenantContext.CurrentTenantId); }
        catch (Exception exception) { _error = $"Credentials could not be loaded: {exception.Message}"; }
        finally { _isLoading = false; }
    }

    private async Task CreateAsync()
    {
        await RunAsync(async () =>
        {
            await CredentialService.CreateAsync(TenantContext.CurrentTenantId!, _name, _type, _description, _key, _value);
            _name = string.Empty; _description = string.Empty; _value = string.Empty;
            await RefreshAsync();
        });
    }

    private async Task RotateAsync(StudioCredential credential)
    {
        await RunAsync(async () =>
        {
            await CredentialService.RotateSecretAsync(TenantContext.CurrentTenantId!, credential.Id, credential.SecretKeys.FirstOrDefault() ?? "value", _value);
            _value = string.Empty;
            await RefreshAsync();
        });
    }

    private async Task DeleteAsync(string id)
    {
        await RunAsync(async () => { await CredentialService.DeleteAsync(TenantContext.CurrentTenantId!, id); await RefreshAsync(); });
    }

    private async Task RunAsync(Func<Task> action)
    {
        _isLoading = true; _error = null;
        try { await action(); }
        catch (Exception exception) { _error = $"Credential operation failed: {exception.Message}"; }
        finally { _isLoading = false; }
    }
}
