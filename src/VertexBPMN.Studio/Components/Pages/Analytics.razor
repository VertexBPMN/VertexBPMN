@page "/analytics"
@using System.Text.Json
@inject IAnalyticsService AnalyticsService

<PageTitle>Analytics</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Process Analytics</MudText>

<MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="RefreshAsync" Disabled="_isLoading" Class="mb-4">
    Refresh
</MudButton>

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
}

<MudGrid>
    <MudItem xs="12" md="6">
        <MudPaper Class="pa-4">
            <MudText Typo="Typo.h6">Process metrics</MudText>
            @RenderPayload(_processMetrics)
        </MudPaper>
    </MudItem>
    <MudItem xs="12" md="6">
        <MudPaper Class="pa-4">
            <MudText Typo="Typo.h6">Event statistics</MudText>
            @RenderPayload(_eventStats)
        </MudPaper>
    </MudItem>
    <MudItem xs="12">
        <MudPaper Class="pa-4">
            <MudText Typo="Typo.h6">Recent process-mining events</MudText>
            @RenderPayload(_events)
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private JsonElement? _processMetrics;
    private JsonElement? _eventStats;
    private JsonElement? _events;
    private bool _isLoading;
    private string? _error;

    protected override Task OnInitializedAsync() => RefreshAsync();

    private async Task RefreshAsync()
    {
        _isLoading = true;
        _error = null;

        try
        {
            var processMetrics = AnalyticsService.GetProcessMetricsAsync();
            var eventStats = AnalyticsService.GetEventStatsAsync();
            var events = AnalyticsService.GetEventsAsync();
            await Task.WhenAll(processMetrics, eventStats, events);

            _processMetrics = await processMetrics;
            _eventStats = await eventStats;
            _events = await events;
        }
        catch (Exception exception)
        {
            _error = $"Analytics data could not be loaded: {exception.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private static RenderFragment RenderPayload(JsonElement? payload) => builder =>
    {
        if (payload is null)
        {
            builder.AddContent(0, "No data available.");
            return;
        }

        builder.OpenElement(1, "pre");
        builder.AddAttribute(2, "class", "mt-3");
        builder.AddContent(3, JsonSerializer.Serialize(payload.Value, new JsonSerializerOptions { WriteIndented = true }));
        builder.CloseElement();
    };
}
