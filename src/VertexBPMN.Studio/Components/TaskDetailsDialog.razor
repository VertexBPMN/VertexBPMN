@inject MudBlazor.ISnackbar Snackbar
@inject IJSRuntime JSRuntime
@inject ITaskService TaskService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ILogger<TaskDetailsDialog> Logger
@inject IExecutionDetailsService ExecutionDetailsService
@inject IWebHostEnvironment HostEnvironment
@implements IAsyncDisposable

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Task Details: @Task.Name</MudText>
    </TitleContent>
    <DialogContent>
        <MudText><b>Id:</b> @Task.Id</MudText>
        <MudText><b>Process Instance Id:</b> @Task.ProcessInstanceId</MudText>
        <MudText><b>Assignee:</b> @(Task.Assignee ?? "Unassigned")</MudText>
        @if (TaskFormState.IsBound(Task))
        {
            <MudText Typo="Typo.h6" Class="mt-4">Task Form</MudText>
            <MudText Typo="Typo.caption">Snapshot revision: @Task.FormVersion · Hash: @Task.FormSchemaHash</MudText>
            <div id="@_formContainerId" class="studio-dialog-form"></div>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => Dialog.Close())">Cancel</MudButton>
        @if (!string.IsNullOrWhiteSpace(_currentUserName) && Task.Assignee == _currentUserName)
        {
            <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@(_submitting || (TaskFormState.IsBound(Task) && !_formInitialized))" OnClick="CompleteTask">Complete</MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] public MudBlazor.IMudDialogInstance Dialog { get; set; } = default!;
    [Parameter] public StudioUserTask Task { get; set; } = default!;
    private string _formJson = "{}";
    private readonly string _formContainerId = $"task-form-{Guid.NewGuid():N}";
    private IJSObjectReference? _module;
    private IJSObjectReference? _formInstance;
    private bool _formInitialized;
    private bool _submitting;
    private string? _currentUserName;
    private IDictionary<string, object?> _prefill = new Dictionary<string, object?>();
    private string? _completionJson;
    private string? _idempotencyKey;
    private bool _schemaLoaded;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _currentUserName = state.User.FindFirstValue("sub")
            ?? state.User.FindFirstValue(ClaimTypes.NameIdentifier)
            ?? (state.User.Identity?.IsAuthenticated == true
                && state.User.Identity?.AuthenticationType == UiTestAuthenticationHandler.Scheme
                    ? state.User.Identity?.Name
                    : null);
        if (!TaskFormState.IsBound(Task)) return;
        try
        {
            if (!string.IsNullOrWhiteSpace(Task.FormSchema))
            {
                _formJson = Task.FormSchema!;
            }
            else
            {
                // Only legacy tasks without snapshots may use local examples.
                var key = Task.FormKey ?? string.Empty;
                if (key != Path.GetFileName(key) || key.Contains("..", StringComparison.Ordinal))
                    throw new InvalidOperationException("Invalid legacy form key.");
                var path = Path.Combine(HostEnvironment.WebRootPath, "data", key + ".json");
                if (!File.Exists(path)) throw new InvalidOperationException("Task form snapshot is unavailable.");
                _formJson = await File.ReadAllTextAsync(path);
            }
            var authorizedData = await ExecutionDetailsService.GetVariablesAsync(Task.ProcessInstanceId);
            _prefill = authorizedData.EnumerateObject().ToDictionary(property => property.Name,
                property => (object?)(property.Value.TryGetProperty("value", out var value) ? value.Clone() : property.Value.Clone()), StringComparer.Ordinal);
            _schemaLoaded = true;
        }
        catch (Exception ex) { Snackbar.Add($"Task form unavailable: {ex.Message}", Severity.Error); }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !_schemaLoaded) return;
        try
        {
            _module = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/form-viewer.js");
            _formInstance = await _module.InvokeAsync<IJSObjectReference>("FormViewerInterop.createViewer", _formContainerId, _formJson, _prefill);
            _formInitialized = true;
            StateHasChanged();
        }
        catch (Exception ex) { Snackbar.Add($"Form init failed: {ex.Message}", Severity.Error); }
    }

    private async Task CompleteTask()
    {
        if (_submitting || Task.Assignee != _currentUserName || (TaskFormState.IsBound(Task) && !_formInitialized)) return;
        _submitting = true;
        try
        {
            string? submittedJson = null;
            if (TaskFormState.IsBound(Task))
                submittedJson = await _module!.InvokeAsync<string>("FormViewerInterop.getData", _formInstance);
            if (_idempotencyKey is null || !string.Equals(_completionJson, submittedJson, StringComparison.Ordinal))
            {
                _completionJson = submittedJson;
                _idempotencyKey = Guid.NewGuid().ToString("N");
            }
            var variables = submittedJson is null ? null : System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, object?>>(submittedJson);
            await TaskService.CompleteTaskAsync(Task.Id, variables, Task.TenantId, Task.Revision, Task.FormSchemaHash, _idempotencyKey);
            Snackbar.Add($"Task {Task.Name} completed!", Severity.Success);
            Dialog.Close(DialogResult.Ok(submittedJson));
        }
        catch (Exception ex) { Snackbar.Add($"Error completing task: {ex.Message}", Severity.Error); }
        finally { _submitting = false; }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_formInstance is not null)
            {
                if (_module is not null) await _module.InvokeVoidAsync("FormViewerInterop.destroy", _formInstance);
                await _formInstance.DisposeAsync();
            }
            if (_module is not null) await _module.DisposeAsync();
        }
        catch (Exception ex) { Logger.LogWarning(ex, "Failed to dispose the task form viewer"); }
    }
}
