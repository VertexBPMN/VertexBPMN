@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

<div class="bpmn-io-shell bpmn-io-shell-single bpmn-io-shell-viewer" data-testid="form-viewer-shell">
    <div id="@_canvasId" class="bpmn-io-canvas"><div class="bpmn-io-canvas-placeholder">Form runtime viewer canvas</div></div>
</div>

@code {
    [Parameter] public string Json { get; set; } = "{}";

    private readonly string _canvasId = $"form-viewer-{Guid.NewGuid():N}";
    private IJSObjectReference? _module;
    private IJSObjectReference? _form;
    private string _loadedJson = string.Empty;
    private bool _initialized;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        _module = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/form-viewer.js");
        _form = await _module.InvokeAsync<IJSObjectReference>("FormViewerInterop.createViewer", _canvasId, Json);
        _loadedJson = Json;
        _initialized = true;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_initialized && _module is not null && _form is not null && Json != _loadedJson)
        {
            await _module.InvokeVoidAsync("FormViewerInterop.loadJson", _form, Json);
            _loadedJson = Json;
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_module is not null && _form is not null)
                await _module.InvokeVoidAsync("FormViewerInterop.destroy", _form);
            if (_module is not null)
                await _module.DisposeAsync();
        }
        catch
        {
            // Ignore browser-disconnect cleanup errors.
        }
    }
}
