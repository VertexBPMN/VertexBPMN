@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

<div class="bpmn-io-shell bpmn-io-shell-viewer" data-testid="bpmn-viewer-shell">
    <div id="@_canvasId" class="bpmn-io-canvas"><div class="bpmn-io-canvas-placeholder">BPMN viewer canvas</div></div>
</div>

@code {
    [Parameter] public string Xml { get; set; } = string.Empty;

    private readonly string _canvasId = $"bpmn-viewer-{Guid.NewGuid():N}";
    private IJSObjectReference? _module;
    private IJSObjectReference? _viewer;
    private string _loadedXml = string.Empty;
    private bool _initialized;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        _module = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/bpmn-viewer.js");
        _viewer = await _module.InvokeAsync<IJSObjectReference>("BpmnViewerInterop.createViewer", _canvasId, Xml);
        _loadedXml = Xml;
        _initialized = true;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_initialized && _module is not null && _viewer is not null && Xml != _loadedXml)
        {
            await _module.InvokeVoidAsync("BpmnViewerInterop.loadXml", _viewer, Xml);
            _loadedXml = Xml;
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_module is not null && _viewer is not null)
                await _module.InvokeVoidAsync("BpmnViewerInterop.destroy", _viewer);
            if (_module is not null)
                await _module.DisposeAsync();
        }
        catch
        {
            // Ignore browser-disconnect cleanup errors.
        }
    }
}
